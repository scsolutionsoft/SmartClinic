@model PatientMedicalProfileEditViewModel
@{
    ViewData["Title"] = "แก้ไขเวชระเบียนผู้รับบริการ";
}

<section class="opd-page-header mb-4">
    <div>
        <div class="text-uppercase text-body-secondary small fw-semibold mb-1">Patient Medical Profile</div>
        <h1 class="h2 fw-semibold mb-1">แก้ไขเวชระเบียนผู้รับบริการ</h1>
        <div class="text-body-secondary">ปรับข้อมูลรายงานเดิม และเปลี่ยนไฟล์ PDF ต้นฉบับได้เมื่อจำเป็น</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">กลับ</a>
        @if (Model.HasPdfFile)
        {
            <button type="button" class="btn btn-outline-primary" data-preview-pdf-url="@Url.Action("Preview", "PatientMedicalProfiles", new { id = Model.Id })">พรีวิวต้นฉบับ</button>
        }
    </div>
</section>

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0 opd-form-card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="CurrentPdfFileName" type="hidden" />
                    <div asp-validation-summary="All" class="alert alert-danger profile-validation-summary mb-3"></div>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">1</span>
                            <div>
                                <h3>ข้อมูลผู้รับบริการ</h3>
                                <p>การแก้ไขส่วนนี้จะอัปเดตข้อมูลผู้ป่วยเดิมด้วย</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ServiceRecipientId" class="form-label"></label>
                                <input asp-for="ServiceRecipientId" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CitizenId" class="form-label"></label>
                                <input asp-for="CitizenId" class="form-control" maxlength="13" />
                                <span asp-validation-for="CitizenId" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="PatientName" class="form-label"></label>
                                <input asp-for="PatientName" class="form-control" />
                                <span asp-validation-for="PatientName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="ไม่ระบุ">ไม่ระบุ</option>
                                    <option value="ชาย">ชาย</option>
                                    <option value="หญิง">หญิง</option>
                                    <option value="อื่นๆ">อื่นๆ</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BirthDate" class="form-label"></label>
                                <input asp-for="BirthDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Race" class="form-label"></label>
                                <input asp-for="Race" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Nationality" class="form-label"></label>
                                <input asp-for="Nationality" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaritalStatus" class="form-label"></label>
                                <input asp-for="MaritalStatus" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="InformationGivenDate" class="form-label"></label>
                                <input asp-for="InformationGivenDate" type="date" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="RegisteredAddress" class="form-label"></label>
                                <textarea asp-for="RegisteredAddress" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-12">
                                <label asp-for="ContactAddress" class="form-label"></label>
                                <textarea asp-for="ContactAddress" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </section>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">2</span>
                            <div>
                                <h3>ประวัติและสิทธิ</h3>
                                <p>แก้ไขข้อมูลที่ต้องการเปลี่ยนแปลงในรายงานเดิม</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UnderlyingDisease" class="form-label"></label>
                                <textarea asp-for="UnderlyingDisease" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PrimaryHospital" class="form-label"></label>
                                <textarea asp-for="PrimaryHospital" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PastHistory" class="form-label"></label>
                                <textarea asp-for="PastHistory" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FamilyHistory" class="form-label"></label>
                                <textarea asp-for="FamilyHistory" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AllergyHistory" class="form-label"></label>
                                <textarea asp-for="AllergyHistory" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MedicalBenefit" class="form-label"></label>
                                <select asp-for="MedicalBenefit" class="form-select">
                                    <option value="">-- เลือกสิทธิการรักษาพยาบาล --</option>
                                    <option value="ประกันสุขภาพถ้วนหน้า (30 บาท)">1. ประกันสุขภาพถ้วนหน้า (30 บาท)</option>
                                    <option value="เบิกจ่ายตรง-ข้าราชการ">2. เบิกจ่ายตรง-ข้าราชการ</option>
                                    <option value="ประกันสังคม">3. ประกันสังคม</option>
                                    <option value="ทราบสิทธิแต่ประสงค์จ่ายเงินเอง">4. ทราบสิทธิแต่ประสงค์จ่ายเงินเอง</option>
                                    <option value="อื่นๆ">5. อื่นๆ</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmergencyContactName" class="form-label"></label>
                                <input asp-for="EmergencyContactName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmergencyContactPhone" class="form-label"></label>
                                <input asp-for="EmergencyContactPhone" class="form-control" />
                            </div>
                        </div>
                    </section>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">3</span>
                            <div>
                                <h3>ไฟล์ PDF ต้นฉบับ</h3>
                        <p>ไฟล์ปัจจุบัน: @(string.IsNullOrWhiteSpace(Model.CurrentPdfFileName) ? "ไม่มีไฟล์แนบ" : Model.CurrentPdfFileName)</p>
                            </div>
                        </div>
                        <div class="profile-pdf-status @(Model.HasPdfFile ? "has-file" : "")" id="profilePdfStatus">
                            <span class="profile-pdf-icon">PDF</span><div><strong id="profilePdfFileName">@(string.IsNullOrWhiteSpace(Model.CurrentPdfFileName) ? "ยังไม่มีไฟล์ PDF ต้นฉบับ" : Model.CurrentPdfFileName)</strong><small id="profilePdfHint">@(Model.HasPdfFile ? "ไฟล์ถูกจัดเก็บในระบบแล้ว" : "สามารถเพิ่มไฟล์ภายหลังได้")</small></div>
                            <div class="d-flex gap-2"><button type="button" id="profileInlinePreview" class="btn btn-outline-secondary btn-sm" data-preview-pdf-url="@Url.Action("Preview", "PatientMedicalProfiles", new { id = Model.Id })" hidden="@(!Model.HasPdfFile)">พรีวิว</button><button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#profilePdfUploadModal">@(Model.HasPdfFile ? "เปลี่ยนไฟล์" : "เพิ่มไฟล์ PDF")</button></div>
                        </div>
                    </section>

                    <div class="opd-sticky-actions">
                        <button type="submit" class="btn btn-primary px-4">บันทึกการแก้ไข</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">ยกเลิก</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="profilePdfUploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content profile-upload-modal">
        <div class="modal-header"><div><span class="profile-upload-icon">PDF</span><div><h2 class="modal-title">อัปโหลด PDF ต้นฉบับ</h2><p>เพิ่มหรือเปลี่ยนไฟล์โดยไม่กระทบข้อมูลเวชระเบียน</p></div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <label class="profile-upload-drop" id="profileUploadDrop"><input type="file" id="profilePdfUploadInput" accept="application/pdf,.pdf" /><span>⇧</span><strong>เลือกไฟล์ PDF</strong><small>หรือลากไฟล์มาวาง · ขนาดไม่เกิน 20 MB</small></label>
            <div class="profile-upload-selected" id="profileUploadSelected" hidden><span>PDF</span><div><strong id="profileUploadName"></strong><small id="profileUploadSize"></small></div><button type="button" id="profileUploadClear">×</button></div>
            <div class="alert alert-danger mt-3 mb-0" id="profileUploadError" hidden></div>
            <div class="profile-upload-progress mt-3" id="profileUploadProgress" hidden><span></span><small>กำลังอัปโหลดและบันทึกไฟล์...</small></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button type="button" class="btn btn-primary" id="profileUploadSubmit" disabled>อัปโหลดไฟล์</button></div>
    </div></div>
</div>

<div class="modal fade" id="profilePdfPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">พรีวิว PDF</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="profilePdfPreviewFrame" style="width:100%;height:78vh;border:0;" title="PDF preview"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('click', function (event) {
            const trigger = event.target.closest('[data-preview-pdf-url]');
            if (!trigger) return;
            const frame = document.getElementById('profilePdfPreviewFrame');
            if (frame) frame.src = trigger.getAttribute('data-preview-pdf-url');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('profilePdfPreviewModal')).show();
        });

        const uploadInput=document.getElementById('profilePdfUploadInput'),drop=document.getElementById('profileUploadDrop'),selected=document.getElementById('profileUploadSelected'),uploadName=document.getElementById('profileUploadName'),uploadSize=document.getElementById('profileUploadSize'),clearButton=document.getElementById('profileUploadClear'),submitButton=document.getElementById('profileUploadSubmit'),errorBox=document.getElementById('profileUploadError'),progress=document.getElementById('profileUploadProgress');
        let selectedPdf=null;
        function setUploadFile(file){errorBox.hidden=true;if(!file){selectedPdf=null;selected.hidden=true;submitButton.disabled=true;uploadInput.value='';return}if(file.type!=='application/pdf'&&!file.name.toLowerCase().endsWith('.pdf')){errorBox.textContent='กรุณาเลือกไฟล์ PDF เท่านั้น';errorBox.hidden=false;return}if(file.size>20*1024*1024){errorBox.textContent='ไฟล์ PDF ต้องมีขนาดไม่เกิน 20 MB';errorBox.hidden=false;return}selectedPdf=file;uploadName.textContent=file.name;uploadSize.textContent=(file.size/1024/1024).toFixed(2)+' MB';selected.hidden=false;submitButton.disabled=false}
        uploadInput?.addEventListener('change',()=>setUploadFile(uploadInput.files?.[0]));clearButton?.addEventListener('click',()=>setUploadFile(null));
        ['dragenter','dragover'].forEach(name=>drop?.addEventListener(name,event=>{event.preventDefault();drop.classList.add('dragging')}));['dragleave','drop'].forEach(name=>drop?.addEventListener(name,event=>{event.preventDefault();drop.classList.remove('dragging')}));drop?.addEventListener('drop',event=>setUploadFile(event.dataTransfer.files?.[0]));
        submitButton?.addEventListener('click',async()=>{if(!selectedPdf)return;const token=document.querySelector('input[name="__RequestVerificationToken"]')?.value,form=new FormData();form.append('id','@Model.Id');form.append('sourcePdfFile',selectedPdf);submitButton.disabled=true;progress.hidden=false;errorBox.hidden=true;try{const response=await fetch('@Url.Action("UploadPdf", "PatientMedicalProfiles")',{method:'POST',headers:token?{'RequestVerificationToken':token}:{},body:form});const payload=await response.json();if(!response.ok||!payload.success)throw new Error(payload.error||'อัปโหลดไม่สำเร็จ');document.getElementById('profilePdfFileName').textContent=payload.fileName;document.getElementById('profilePdfHint').textContent='อัปโหลดและบันทึกไฟล์เรียบร้อยแล้ว';document.getElementById('profilePdfStatus').classList.add('has-file');const preview=document.getElementById('profileInlinePreview');preview.dataset.previewPdfUrl=payload.previewUrl;preview.hidden=false;bootstrap.Modal.getInstance(document.getElementById('profilePdfUploadModal'))?.hide();setUploadFile(null)}catch(error){errorBox.textContent=error.message;errorBox.hidden=false}finally{progress.hidden=true;submitButton.disabled=!selectedPdf}});
    </script>
}
