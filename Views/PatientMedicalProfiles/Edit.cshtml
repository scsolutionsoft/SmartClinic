@model PatientMedicalProfileEditViewModel
@{
    ViewData["Title"] = "แก้ไขเวชระเบียนผู้รับบริการ";
}

<section class="opd-page-header mb-4">
    <div>
        <div class="text-uppercase text-body-secondary small fw-semibold mb-1">Patient Medical Profile</div>
        <h1 class="h2 fw-semibold mb-1">แก้ไขเวชระเบียนผู้รับบริการ</h1>
        <div class="text-body-secondary">ปรับข้อมูลรายงานเดิม และเปลี่ยนไฟล์ PDF ต้นฉบับได้เมื่อจำเป็น</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">กลับ</a>
        @if (Model.HasPdfFile)
        {
            <button type="button" class="btn btn-outline-primary" data-preview-pdf-url="@Url.Action("Preview", "PatientMedicalProfiles", new { id = Model.Id })">พรีวิวต้นฉบับ</button>
        }
    </div>
</section>

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card shadow-sm border-0 opd-form-card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="CurrentPdfFileName" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">1</span>
                            <div>
                                <h3>ข้อมูลผู้รับบริการ</h3>
                                <p>การแก้ไขส่วนนี้จะอัปเดตข้อมูลผู้ป่วยเดิมด้วย</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ServiceRecipientId" class="form-label"></label>
                                <input asp-for="ServiceRecipientId" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CitizenId" class="form-label"></label>
                                <input asp-for="CitizenId" class="form-control" maxlength="13" />
                                <span asp-validation-for="CitizenId" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="PatientName" class="form-label"></label>
                                <input asp-for="PatientName" class="form-control" />
                                <span asp-validation-for="PatientName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="ไม่ระบุ">ไม่ระบุ</option>
                                    <option value="ชาย">ชาย</option>
                                    <option value="หญิง">หญิง</option>
                                    <option value="อื่นๆ">อื่นๆ</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BirthDate" class="form-label"></label>
                                <input asp-for="BirthDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Race" class="form-label"></label>
                                <input asp-for="Race" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Nationality" class="form-label"></label>
                                <input asp-for="Nationality" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaritalStatus" class="form-label"></label>
                                <input asp-for="MaritalStatus" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="InformationGivenDate" class="form-label"></label>
                                <input asp-for="InformationGivenDate" type="date" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="RegisteredAddress" class="form-label"></label>
                                <textarea asp-for="RegisteredAddress" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-12">
                                <label asp-for="ContactAddress" class="form-label"></label>
                                <textarea asp-for="ContactAddress" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </section>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">2</span>
                            <div>
                                <h3>ประวัติและสิทธิ</h3>
                                <p>แก้ไขข้อมูลที่ต้องการเปลี่ยนแปลงในรายงานเดิม</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UnderlyingDisease" class="form-label"></label>
                                <textarea asp-for="UnderlyingDisease" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PrimaryHospital" class="form-label"></label>
                                <textarea asp-for="PrimaryHospital" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PastHistory" class="form-label"></label>
                                <textarea asp-for="PastHistory" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FamilyHistory" class="form-label"></label>
                                <textarea asp-for="FamilyHistory" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AllergyHistory" class="form-label"></label>
                                <textarea asp-for="AllergyHistory" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MedicalBenefit" class="form-label"></label>
                                <select asp-for="MedicalBenefit" class="form-select">
                                    <option value="">-- เลือกสิทธิการรักษาพยาบาล --</option>
                                    <option value="ประกันสุขภาพถ้วนหน้า (30 บาท)">1. ประกันสุขภาพถ้วนหน้า (30 บาท)</option>
                                    <option value="เบิกจ่ายตรง-ข้าราชการ">2. เบิกจ่ายตรง-ข้าราชการ</option>
                                    <option value="ประกันสังคม">3. ประกันสังคม</option>
                                    <option value="ทราบสิทธิแต่ประสงค์จ่ายเงินเอง">4. ทราบสิทธิแต่ประสงค์จ่ายเงินเอง</option>
                                    <option value="อื่นๆ">5. อื่นๆ</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmergencyContactName" class="form-label"></label>
                                <input asp-for="EmergencyContactName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmergencyContactPhone" class="form-label"></label>
                                <input asp-for="EmergencyContactPhone" class="form-control" />
                            </div>
                        </div>
                    </section>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">3</span>
                            <div>
                                <h3>ไฟล์ PDF ต้นฉบับ</h3>
                        <p>ไฟล์ปัจจุบัน: @(string.IsNullOrWhiteSpace(Model.CurrentPdfFileName) ? "ไม่มีไฟล์แนบ" : Model.CurrentPdfFileName)</p>
                            </div>
                        </div>
                        <input asp-for="SourcePdfFile" type="file" accept="application/pdf" class="form-control" />
                        <div class="form-text">ไม่บังคับ เลือกไฟล์เฉพาะกรณีต้องการเพิ่มหรือเปลี่ยน PDF ต้นฉบับ</div>
                        <span asp-validation-for="SourcePdfFile" class="text-danger"></span>
                    </section>

                    <div class="opd-sticky-actions">
                        <button type="submit" class="btn btn-primary px-4">บันทึกการแก้ไข</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">ยกเลิก</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="profilePdfPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">พรีวิว PDF</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="profilePdfPreviewFrame" style="width:100%;height:78vh;border:0;" title="PDF preview"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('click', function (event) {
            const trigger = event.target.closest('[data-preview-pdf-url]');
            if (!trigger) return;
            const frame = document.getElementById('profilePdfPreviewFrame');
            if (frame) frame.src = trigger.getAttribute('data-preview-pdf-url');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('profilePdfPreviewModal')).show();
        });
    </script>
}
