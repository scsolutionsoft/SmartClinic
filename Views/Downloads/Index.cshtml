@{
    ViewData["Title"] = "ดาวน์โหลด";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="card shadow-sm border-0 mb-4 content-intro-card">
            <div class="card-body p-4 p-lg-5">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                    <div>
                        <h1 class="h3 mb-2">@ViewData["Title"]</h1>
                        <p class="text-body-secondary mb-0">ลิงก์ดาวน์โหลดไฟล์ติดตั้ง คู่มือ และไฟล์ประกอบสำหรับ SmartClinic</p>
                    </div>
                    <span class="download-hero-icon align-self-start align-self-lg-center" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M11 3h2v10l3.5-3.5 1.4 1.4L12 16.8l-5.9-5.9 1.4-1.4L11 13V3ZM4 19h16v2H4v-2Z"/></svg></span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">ไฟล์ติดตั้ง</h2>
                        <p class="text-body-secondary">ใช้สำหรับติดตั้งระบบบนเครื่องใหม่</p>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-action="DownloadsGuide" asp-controller="Downloads">ดาวน์โหลดคู่มือไฟล์</a>
                            <a class="btn btn-outline-primary" asp-action="InstallationGuide" asp-controller="Downloads">ดาวน์โหลดคู่มือการติดตั้ง</a>
                            <a class="btn btn-outline-primary" asp-action="QuickStartGuide" asp-controller="Downloads">ดาวน์โหลดคู่มือเริ่มต้นเร็ว</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">เอกสารระบบ</h2>
                        <p class="text-body-secondary">เอกสารอ้างอิงสำหรับผู้ใช้งานและผู้ดูแลระบบ</p>
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-secondary" asp-action="Readme" asp-controller="Downloads">README</a>
                            <a class="btn btn-outline-secondary" asp-action="DeploymentGuide" asp-controller="Downloads">Deployment Guide</a>
                            <a class="btn btn-outline-secondary" asp-action="ProductInfo" asp-controller="Downloads">Product Information</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="card shadow-sm border-success">
                    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <h2 class="h5 mb-1">ไฟล์ติดตั้ง Smart Card Bridge</h2>
                            <p class="text-body-secondary mb-0">
                                ดาวน์โหลดแพ็กเกจ SmartClinic-CardReader-Bridge-v1.0.4.zip
                                <span class="badge text-bg-light">ประมาณ 6 MB</span>
                            </p>
                        </div>
                        <a class="btn btn-success"
                           asp-action="BridgePackage"
                           asp-controller="Downloads"
                           download="SmartClinic-CardReader-Bridge-v1.0.4.zip">
                            ดาวน์โหลดไฟล์ติดตั้ง Bridge (.zip)
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h2 class="h5">หมายเหตุ</h2>
                <p class="mb-0 text-body-secondary">
                    ถ้าต้องการไฟล์โปรแกรมติดตั้งจริง (.zip/.exe) ให้สร้าง Release package จากโฟลเดอร์ build หรือวางไฟล์ไว้ใน wwwroot แล้วปรับลิงก์ให้ชี้ไปยังไฟล์นั้น
                </p>
            </div>
        </div>
    </div>
</div>
