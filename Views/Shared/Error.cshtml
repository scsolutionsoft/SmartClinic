@model ErrorViewModel
@{
    ViewData["Title"] = "ไม่สามารถดำเนินการได้";
}

<div class="system-state-page">
    <div class="system-state-icon">!</div>
    <div class="text-uppercase text-danger small fw-bold">System notification</div>
    <h1>ไม่สามารถดำเนินการได้</h1>
    <p>ระบบพบข้อผิดพลาดระหว่างประมวลผล กรุณาลองใหม่อีกครั้งหรือกลับไปยังแดชบอร์ด</p>
    @if (Model.ShowRequestId)
    {
        <div class="system-request-id">รหัสอ้างอิง: <code>@Model.RequestId</code></div>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">กลับไปแดชบอร์ด</a>
</div>
