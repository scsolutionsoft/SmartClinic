@model MedicalRecordsDashboardViewModel
<link rel="stylesheet" href="~/css/opd-drug-assistant.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/opd-drug-meta.css" asp-append-version="true" />
<style>#drugAssistantAuto [data-bs-target="#opdExternalDrugModal"]{display:none!important}</style>
@{
    ViewData["Title"] = "เวชระเบียน OPD";
}

<section class="opd-page-header mb-4">
    <div>
        <div class="text-uppercase text-body-secondary small fw-semibold mb-1">OPD Medical Records</div>
        <h1 class="h2 fw-semibold mb-1">@(Model.EditRecordId.HasValue ? "แก้ไขเวชระเบียน" : "เพิ่มเวชระเบียนจาก PDF")</h1>
        <div class="text-body-secondary">ค้นผู้ป่วย อัปโหลด PDF ตรวจข้อมูล แล้วบันทึกประวัติการรักษา</div>
    </div>
    <div class="opd-status-panel">
        <span class="opd-status-dot"></span>
        <span>@Model.StatusMessage</span>
    </div>
</section>

<section class="patient-quota-bar @(Model.IsUnlimited ? "unlimited" : Model.RemainingOpdRecords == 0 ? "exhausted" : Model.RemainingOpdRecords <= 5 ? "low" : "") mb-4">
    <div class="quota-symbol">@(Model.IsUnlimited ? "∞" : "OPD")</div>
    <div class="quota-copy"><small>เครดิตเวชระเบียน OPD</small><strong>@(Model.IsUnlimited ? "บันทึกได้ไม่จำกัด" : $"ใช้แล้ว {Model.UsedOpdRecords} จาก {Model.OpdRecordLimit} รายการ")</strong><div class="quota-progress"><i style="width:@(Model.IsUnlimited ? 100 : Math.Min(100, Model.OpdRecordLimit == 0 ? 100 : Model.UsedOpdRecords * 100 / Model.OpdRecordLimit))%"></i></div></div>
    <div class="quota-remaining"><small>คงเหลือ</small><strong>@(Model.IsUnlimited ? "Unlimited" : $"{Model.RemainingOpdRecords} รายการ")</strong></div>
    @if (!Model.IsUnlimited && Model.RemainingOpdRecords <= 5)
    {
        <div class="quota-actions"><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#opdCreditRequestModal">ติดต่อเติมเครดิต</button></div>
    }
</section>

<div class="opd-step-strip mb-4">
    <div class="opd-step active">
        <span>1</span>
        <strong>เลือกผู้ป่วย</strong>
    </div>
    <div class="opd-step">
        <span>2</span>
        <strong>อ่าน PDF</strong>
    </div>
    <div class="opd-step">
        <span>3</span>
        <strong>ตรวจข้อมูล</strong>
    </div>
    <div class="opd-step">
        <span>4</span>
        <strong>บันทึก</strong>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7 col-lg-6">
        <div class="card shadow-sm border-0 opd-form-card" id="medical-record-form-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 fw-semibold mb-0">ข้อมูลเวชระเบียน</h2>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-status-modal='{"type":"primary","subtitle":"OPD upload flow","state":"Ready","stateDescription":"พร้อมอ่านและบันทึก PDF","message":"เลือกผู้ป่วย อัปโหลด PDF อ่านข้อมูล ตรวจทาน แล้วบันทึกลง SQL Server","meta":"PDF stored as varbinary(max)","actionText":"ตกลง"}'>
                        ดูขั้นตอน
                    </button>
                </div>

                <form asp-action="@(Model.EditRecordId.HasValue ? "Update" : "Create")"
                      asp-route-id="@Model.EditRecordId"
                      method="post"
                      enctype="multipart/form-data"
                      id="medicalRecordForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input asp-for="Input.PatientId" type="hidden" id="medicalPatientId" />

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">1</span>
                            <div>
                                <h3>ผู้ป่วยและไฟล์ PDF</h3>
                                <p>ค้นจากชื่อ/เลขบัตร หรือให้ระบบเติมจากไฟล์ PDF อัตโนมัติ</p>
                            </div>
                        </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="patientSearchBox">ค้นหาผู้ป่วย</label>
                        <input id="patientSearchBox" class="form-control" autocomplete="off" placeholder="ชื่อ นามสกุล หรือเลขบัตรประชาชน" />
                        <div class="list-group mt-2" id="patientSearchResults" style="display:none;"></div>
                        <div class="form-text" id="selectedPatientText">ยังไม่ได้เลือกผู้ป่วย</div>
                        <span asp-validation-for="Input.PatientId" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CitizenId" class="form-label"></label>
                            <input asp-for="Input.CitizenId" class="form-control" id="medicalCitizenId" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ServiceRecipientId" class="form-label"></label>
                            <input asp-for="Input.ServiceRecipientId" class="form-control" id="serviceRecipientId" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.VisitDate" class="form-label"></label>
                            <input asp-for="Input.VisitDate" type="datetime-local" class="form-control" id="visitDateInput" min="1900-01-01T00:00" step="60" />
                            <span asp-validation-for="Input.VisitDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.AuthenticationCode" class="form-label"></label>
                            <input asp-for="Input.AuthenticationCode" class="form-control" id="authenticationCode" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch self-pay-switch w-100">
                                <input asp-for="Input.IsSelfPay" class="form-check-input" />
                                <label asp-for="Input.IsSelfPay" class="form-check-label fw-semibold"></label>
                                <div class="form-text">เลือกเมื่อมีการเรียกเก็บค่าบริการ ค่ายา หรือเวชภัณฑ์จากผู้ป่วย</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.OpdPdfFile" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.OpdPdfFile" type="file" accept="application/pdf" class="form-control" id="opdPdfFile" />
                                <button type="button" class="btn btn-info text-white" data-medical-pdf-import="true">
                                    อ่านข้อมูลจาก PDF
                                </button>
                            </div>
                            <span asp-validation-for="Input.OpdPdfFile" class="text-danger"></span>
                            <div class="form-text">ไม่จำเป็นต้องแนบไฟล์ หากไม่ได้อ่านข้อมูลจาก OPD Card PDF</div>
                        </div>
                    </div>
                    </section>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">2</span>
                            <div>
                                <h3>ข้อมูลการรักษา</h3>
                                <p>ตรวจทานข้อมูลที่ระบบอ่านจาก PDF ก่อนบันทึก</p>
                            </div>
                        </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.Diagnosis" class="form-label"></label>
                            <div class="icd-autocomplete" data-icd-mode="primary">
                                <div class="input-group"><span class="input-group-text icd-code-mark">ICD</span><input asp-for="Input.Diagnosis" class="form-control" id="diagnosisInput" autocomplete="off" placeholder="ค้นหาด้วยรหัส ชื่อโรคภาษาไทย หรือภาษาอังกฤษ" /></div>
                                <input asp-for="Input.PrimaryIcd10Code" type="hidden" id="primaryIcd10Code" />
                                <div class="icd-results" id="primaryIcdResults" hidden></div>
                                <div class="form-text">เลือกจากรายการเพื่อกำหนดรหัสวินิจฉัยหลัก ข้อความที่อ่านจาก PDF ยังคงแก้ไขได้</div>
                                <div class="icd-selected" id="primaryIcdSelected"></div>
                            </div>
                            <span asp-validation-for="Input.Diagnosis" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.InitialDifferentialDiagnosis" class="form-label"></label>
                            <div class="icd-autocomplete mb-2" data-icd-mode="differential">
                                <div class="input-group"><span class="input-group-text icd-code-mark alt">ICD</span><input class="form-control" id="differentialIcdSearch" autocomplete="off" placeholder="เพิ่มรหัสวินิจฉัยแยกโรค (เลือกได้หลายรายการ)" /></div>
                                <input asp-for="Input.DifferentialIcd10Codes" type="hidden" id="differentialIcd10Codes" />
                                <div class="icd-results" id="differentialIcdResults" hidden></div>
                                <div class="icd-selected" id="differentialIcdSelected"></div>
                            </div>
                            <textarea asp-for="Input.InitialDifferentialDiagnosis" class="form-control" rows="2" id="initialDifferentialDiagnosis"></textarea>
                            <div class="form-text">สามารถเก็บข้อความวินิจฉัยจาก PDF ควบคู่กับรหัส ICD-10 ได้</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.ChiefComplaint" class="form-label"></label>
                            <textarea asp-for="Input.ChiefComplaint" class="form-control" rows="2" id="chiefComplaint"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.PresentIllness" class="form-label"></label>
                            <textarea asp-for="Input.PresentIllness" class="form-control" rows="3" id="presentIllness"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="vital-signs-card">
                                <div class="vital-signs-head"><div><span class="vital-icon">♥</span><div><strong>สัญญาณชีพและสัดส่วนร่างกาย</strong><small>กรอกเองหรือให้ระบบแยกค่าจาก PDF</small></div></div><span id="vitalStatus">พร้อมรับข้อมูล</span></div>
                                <div class="vital-input-grid">
                                    <label><span>อุณหภูมิ</span><div><input asp-for="Input.TemperatureCelsius" type="number" step="0.1" min="25" max="45" id="temperatureCelsius" inputmode="decimal" /><em>°C</em></div></label>
                                    <label><span>ชีพจร</span><div><input asp-for="Input.PulseRate" type="number" min="20" max="250" id="pulseRate" inputmode="numeric" /><em>ครั้ง/นาที</em></div></label>
                                    <label><span>การหายใจ</span><div><input asp-for="Input.RespiratoryRate" type="number" min="5" max="100" id="respiratoryRate" inputmode="numeric" /><em>ครั้ง/นาที</em></div></label>
                                    <label class="vital-bp"><span>ความดันโลหิต</span><div><input asp-for="Input.SystolicPressure" type="number" min="40" max="300" id="systolicPressure" inputmode="numeric" aria-label="ความดันตัวบน" /><b>/</b><input asp-for="Input.DiastolicPressure" type="number" min="20" max="200" id="diastolicPressure" inputmode="numeric" aria-label="ความดันตัวล่าง" /><em>mmHg</em></div></label>
                                    <label><span>น้ำหนัก</span><div><input asp-for="Input.WeightKilograms" type="number" step="0.1" min="1" max="500" id="weightKilograms" inputmode="decimal" /><em>กก.</em></div></label>
                                    <label><span>ส่วนสูง</span><div><input asp-for="Input.HeightCentimeters" type="number" step="0.1" min="30" max="250" id="heightCentimeters" inputmode="decimal" /><em>ซม.</em></div></label>
                                </div>
                                <div class="bmi-result" id="bmiResult"><div><span>BMI</span><strong id="bmiValue">-</strong><small>กก./ม²</small></div><em id="bmiCategory">กรอกน้ำหนักและส่วนสูงเพื่อคำนวณ</em><input asp-for="Input.BodyMassIndex" type="hidden" id="bodyMassIndex" /></div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.PhysicalExam" class="form-label"></label>
                            <textarea asp-for="Input.PhysicalExam" class="form-control" rows="3" id="physicalExam"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.ProblemPhysicalExam" class="form-label"></label>
                            <textarea asp-for="Input.ProblemPhysicalExam" class="form-control" rows="3" id="problemPhysicalExam"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.TreatmentAndAdvice" class="form-label"></label>
                            <div class="opd-drug-assistant" id="opdDrugAssistant">
                                <div class="oda-head"><div><span>CLINICAL SUPPORT</span><h4>ยาและคำแนะนำ</h4><p>เลือกจากข้อมูลที่คลินิกผูกกับ ICD-10 หรือกรอกเอง</p></div><div class="oda-safety">ผู้ให้บริการต้องตรวจสอบและยืนยันก่อนใช้</div></div>
                                <div class="oda-mode"><button type="button" class="active" data-drug-mode="auto"><b>แนะนำอัตโนมัติ</b><small>จาก ICD-10 และข้อมูลเดิม</small></button><button type="button" data-drug-mode="manual"><b>เลือกและกรอกเอง</b><small>ใช้ช่องข้อความด้านล่าง</small></button></div>
                                <div class="oda-auto" id="drugAssistantAuto"><div class="oda-tools"><span id="drugAssistantCodes">กรุณาเลือกการวินิจฉัย ICD-10</span><div><button type="button" class="btn btn-sm btn-outline-primary" id="refreshDrugSuggestions">โหลดคำแนะนำ</button><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#opdExternalDrugModal">ค้นหายาภายนอก</button>@if(User.IsInRole("SuperAdmin")||User.IsInRole("AdminClinic")){<a class="btn btn-sm btn-outline-secondary" asp-controller="DrugCatalog" asp-action="Index" target="_blank">จัดการคลังยา</a>}</div></div><div class="oda-state" id="drugSuggestionState">ระบบจะแสดงยาหลังจากเลือกรหัส ICD-10</div><div class="oda-grid"><div><h5>ยาที่แนะนำ</h5><div id="suggestedDrugList" class="oda-list"></div></div><div><h5>คำแนะนำและคำเตือน</h5><div id="suggestedAdviceList" class="oda-list advice"></div></div></div><div class="oda-footer"><span id="drugSelectionSummary">ยังไม่ได้เลือกรายการ</span><button type="button" class="btn btn-primary" id="applyDrugSuggestions">เพิ่มรายการที่เลือกลงรายงาน</button></div></div>
                                <div class="oda-manual" id="drugAssistantManual" hidden><div><strong>โหมดกรอกเอง</strong><p>กรอกหรือวางข้อความตามรูปแบบเดิม ระบบจะเก็บไว้กับ OPD โดยไม่เปลี่ยนคลังยากลาง</p></div>@if(User.IsInRole("SuperAdmin")||User.IsInRole("AdminClinic")){<a asp-controller="DrugCatalog" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-primary">เพิ่มข้อมูลใหม่เข้าคลัง</a>}</div>
                            </div>
                            <textarea asp-for="Input.TreatmentAndAdvice" class="form-control" rows="6" id="treatmentAndAdvice"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.ReferralDetail" class="form-label"></label>
                            <input asp-for="Input.ReferralDetail" class="form-control" id="referralDetail" />
                        </div>
                    </div>
                    </section>

                    <section class="opd-form-section">
                        <div class="opd-form-section-header">
                            <span class="opd-section-index">3</span>
                            <div>
                                <h3>การติดตามและข้อมูลเพิ่มเติม</h3>
                                <p>ระบุการติดตาม กรณีเด็ก และหมายเหตุถ้ามี</p>
                            </div>
                        </div>
                    <div class="row g-3">
                        <div class="col-12 border rounded-3 p-3 bg-body-tertiary">
                            <div class="fw-semibold mb-2">การติดตามผู้รับบริการ</div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input asp-for="Input.FollowUpNone" class="form-check-input" id="followUpNone" />
                                        <label asp-for="Input.FollowUpNone" class="form-check-label"></label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="Input.FollowUpPhone" class="form-check-input" id="followUpPhone" />
                                        <label asp-for="Input.FollowUpPhone" class="form-check-label"></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input asp-for="Input.FollowUpClinic" class="form-check-input" id="followUpClinic" />
                                        <label asp-for="Input.FollowUpClinic" class="form-check-label"></label>
                                    </div>
                                    <input asp-for="Input.FollowUpClinicNote" class="form-control form-control-sm mb-2" id="followUpClinicNote" placeholder="ระบุการนัดที่คลินิก" />
                                    <input asp-for="Input.FollowUpAppointmentDateTime" type="hidden" id="followUpAppointmentDateTime" />
                                    <button type="button" class="appointment-picker-button mb-2" id="openAppointmentPicker"><span>◷</span><span><strong id="appointmentPickerText">เลือกวันและเวลานัด</strong><small>แตะเพื่อเปิดปฏิทิน</small></span><b>›</b></button>
                                    <span asp-validation-for="Input.FollowUpAppointmentDateTime" class="text-danger small"></span>
                                    <div class="form-check">
                                        <input asp-for="Input.FollowUpOther" class="form-check-input" id="followUpOther" />
                                        <label asp-for="Input.FollowUpOther" class="form-check-label"></label>
                                    </div>
                                    <input asp-for="Input.FollowUpOtherNote" class="form-control form-control-sm" id="followUpOtherNote" placeholder="ระบุช่องทางอื่น" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ServiceEndDateTime" class="form-label"></label>
                            <input asp-for="Input.ServiceEndDateTime" type="datetime-local" class="form-control" id="serviceEndDateTime" min="1900-01-01T00:00" step="60" />
                        </div>

                        <div class="col-12 border rounded-3 p-3 bg-body-tertiary">
                            <div class="form-check form-switch mb-3">
                                <input asp-for="Input.IsChildCase" class="form-check-input" type="checkbox" id="isChildCase" />
                                <label asp-for="Input.IsChildCase" class="form-check-label fw-semibold"></label>
                            </div>
                            <div id="childCaseFields" style="display:none;">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="Input.ChildGrowthStatus" class="form-label"></label>
                                        <select asp-for="Input.ChildGrowthStatus" class="form-select">
                                            <option value="">-</option>
                                            <option value="สมวัย">สมวัย</option>
                                            <option value="ไม่สมวัย">ไม่สมวัย</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="Input.ChildDevelopmentStatus" class="form-label"></label>
                                        <select asp-for="Input.ChildDevelopmentStatus" class="form-select">
                                            <option value="">-</option>
                                            <option value="ปกติ">ปกติ</option>
                                            <option value="ไม่ปกติ">ไม่ปกติ</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="Input.ChildVaccineStatus" class="form-label"></label>
                                        <select asp-for="Input.ChildVaccineStatus" class="form-select">
                                            <option value="">-</option>
                                            <option value="ครบ">ครบ</option>
                                            <option value="ไม่ครบ">ไม่ครบ</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Input.ChildVaccineNote" class="form-label"></label>
                                        <input asp-for="Input.ChildVaccineNote" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.Note" class="form-label"></label>
                            <textarea asp-for="Input.Note" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Input.Note" class="text-danger"></span>
                        </div>
                    </div>
                    </section>

                    <div class="opd-action-bar mt-4 d-flex gap-2 flex-wrap">
                        <button type="@(Model.EditRecordId.HasValue || Model.IsUnlimited || Model.RemainingOpdRecords > 0 ? "submit" : "button")" class="btn btn-primary" @if(!Model.EditRecordId.HasValue && !Model.IsUnlimited && Model.RemainingOpdRecords == 0){<text>data-bs-toggle="modal" data-bs-target="#opdCreditRequestModal"</text>}>@(Model.EditRecordId.HasValue ? "บันทึกการแก้ไข" : Model.IsUnlimited || Model.RemainingOpdRecords > 0 ? "บันทึก OPD Card" : "ติดต่อเติมเครดิต")</button>
                        @if (Model.EditRecordId.HasValue)
                        {
                            <a asp-action="Index" asp-route-patientId="@Model.Input.PatientId" class="btn btn-outline-secondary">ยกเลิก</a>
                        }
                        <button type="button" class="btn btn-outline-secondary" id="previewSelectedPdfButton" disabled>พรีวิว PDF ที่เลือก</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-5 col-lg-6" id="latest-records">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 fw-semibold mb-0">ประวัติการรักษาล่าสุด</h2>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-light">ทั้งหมด @Model.TotalItems รายการ</span>
                        <a asp-action="Index" asp-fragment="medical-record-form-card" class="btn btn-primary btn-sm icon-action-btn" title="เพิ่มประวัติการรักษา" aria-label="เพิ่มประวัติการรักษา">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z"/></svg>
                        </a>
                    </div>
                </div>

                <form asp-action="Index" method="get" class="mb-3">
                    <input type="hidden" name="patientId" value="@Model.Input.PatientId" />
                    <label for="medical-record-search" class="visually-hidden">ค้นหาชื่อ-นามสกุล หรือเลขบัตรประจำตัวประชาชน</label>
                    <div class="input-group">
                        <input id="medical-record-search"
                               name="search"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="ค้นหาชื่อ-นามสกุล หรือเลขบัตรประชาชน"
                               autocomplete="off" />
                        <button type="submit" class="btn btn-primary icon-action-btn" title="ค้นหา" aria-label="ค้นหา">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 20-5.2-5.2a7.5 7.5 0 1 0-1 1L20 21l1-1ZM5 10.5a5.5 5.5 0 1 1 11 0 5.5 5.5 0 0 1-11 0Z"/></svg>
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <a asp-action="Index"
                               asp-route-patientId="@Model.Input.PatientId"
                               asp-fragment="latest-records"
                               class="btn btn-outline-secondary icon-action-btn"
                               title="ล้างการค้นหา"
                               aria-label="ล้างการค้นหา">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3 1.4 1.4Z"/></svg>
                            </a>
                        }
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table align-middle opd-records-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:58px;">#</th>
                                <th>ผู้ป่วย</th>
                                <th>วันที่</th>
                                <th>Auth</th>
                                <th>วินิจฉัย</th>
                                <th class="text-end">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var recordIndex = ((Model.CurrentPage - 1) * MedicalRecordsDashboardViewModel.PageSize) + 1; }
                            @foreach (var record in Model.Records)
                            {
                                <tr>
                                    <td class="text-center">
                                        <span class="opd-record-rank">@recordIndex</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@record.PatientName</div>
                                        <div class="small text-body-secondary">@record.CitizenId</div>
                                        @if (!string.IsNullOrWhiteSpace(record.ServiceRecipientId))
                                        {
                                            <div class="small text-body-secondary">HN: @record.ServiceRecipientId</div>
                                        }
                                    </td>
                                    <td>
                                        <div>@record.VisitDateText</div>
                                        <div class="small text-body-secondary">สร้าง @record.CreatedAtText</div>
                                    </td>
                                    <td class="small">@record.AuthenticationCode</td>
                                    <td style="max-width:260px;">
                                        <div class="text-truncate" title="@record.Diagnosis">@record.Diagnosis</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="record-icon-actions">
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm icon-action-btn"
                                                data-preview-pdf-url="@Url.Action("Preview", "MedicalRecords", new { id = record.Id })"
                                                data-preview-pdf-title="OPD Card: @record.PatientName"
                                                title="ดู PDF"
                                                aria-label="ดู PDF ของ @record.PatientName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c-5.5 0-9.5 5.2-9.7 5.4L1.8 12l.5.6C2.5 12.8 6.5 18 12 18s9.5-5.2 9.7-5.4l.5-.6-.5-.6C21.5 10.2 17.5 5 12 5Zm0 11c-3.7 0-6.8-3.1-7.7-4 .9-.9 4-4 7.7-4s6.8 3.1 7.7 4c-.9.9-4 4-7.7 4Zm0-6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z"/></svg>
                                        </button>
                                        <a class="btn btn-outline-primary btn-sm icon-action-btn" asp-controller="MedicalRecords" asp-action="Report" asp-route-id="@record.Id" title="รายงาน" aria-label="เปิดรายงานของ @record.PatientName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l5 5v15H6V2Zm8 2H8v16h10V8h-4V4Zm2 1.4V6h.6L16 5.4ZM10 11h6v2h-6v-2Zm0 4h6v2h-6v-2Z"/></svg>
                                        </a>
                                        @if (record.IsSelfPay)
                                        {
                                            <a class="btn btn-outline-success btn-sm icon-action-btn"
                                               asp-controller="MedicalRecords"
                                               asp-action="SelfPayConsent"
                                               asp-route-id="@record.Id"
                                               title="พิมพ์หนังสือยินยอมชำระค่าบริการเอง"
                                               aria-label="พิมพ์หนังสือยินยอมชำระค่าบริการเองของ @record.PatientName">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10v4h2a3 3 0 0 1 3 3v7h-4v6H6v-6H2V9a3 3 0 0 1 3-3h2V2Zm2 2v4h6V4H9Zm-1 9v7h8v-7H8Zm10-2a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/></svg>
                                            </a>
                                        }
                                        <a class="btn btn-outline-warning btn-sm icon-action-btn" asp-action="Edit" asp-route-id="@record.Id" title="แก้ไข" aria-label="แก้ไขประวัติของ @record.PatientName">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16.5-.7 4.2 4.2-.7L19.8 7.7l-3.5-3.5L4 16.5Zm2.5 1.7-1 .2.2-1L16.3 6.9l.8.8L6.5 18.2ZM18 2.5l3.5 3.5-1.4 1.4-3.5-3.5L18 2.5Z"/></svg>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@record.Id" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบประวัติการรักษาของ @record.PatientName ?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm icon-action-btn" title="ลบ" aria-label="ลบประวัติของ @record.PatientName">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8l1 2h4v2H3V5h4l1-2Zm-2 6h12l-1 12H7L6 9Zm3 2v7h2v-7H9Zm4 0v7h2v-7h-2Z"/></svg>
                                            </button>
                                        </form>
                                        </div>
                                    </td>
                                </tr>

                                recordIndex++;
                            }
                            @if (!Model.Records.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-body-secondary py-4">
                                        @(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "ยังไม่มีประวัติการรักษา" : "ไม่พบข้อมูลผู้ป่วยที่ค้นหา")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="medical-records-pagination" class="mt-3">
                        <ul class="pagination pagination-sm justify-content-end mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : string.Empty)">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-patientId="@Model.Input.PatientId" asp-route-search="@Model.SearchTerm" asp-fragment="latest-records" title="หน้าก่อนหน้า" aria-label="หน้าก่อนหน้า">‹</a>
                            </li>

                            @{
                                var pageNumbers = new SortedSet<int> { 1, Model.TotalPages };
                                for (var pageNumber = Model.CurrentPage - 2; pageNumber <= Model.CurrentPage + 2; pageNumber++)
                                {
                                    if (pageNumber >= 1 && pageNumber <= Model.TotalPages)
                                    {
                                        pageNumbers.Add(pageNumber);
                                    }
                                }

                                int? previousPage = null;
                            }

                            @foreach (var pageNumber in pageNumbers)
                            {
                                if (previousPage.HasValue && pageNumber - previousPage.Value > 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }

                                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                                    <a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-patientId="@Model.Input.PatientId" asp-route-search="@Model.SearchTerm" asp-fragment="latest-records">@pageNumber</a>
                                </li>

                                previousPage = pageNumber;
                            }

                            <li class="page-item disabled">
                                <span class="page-link">หน้า @Model.CurrentPage / @Model.TotalPages</span>
                            </li>

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : string.Empty)">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-patientId="@Model.Input.PatientId" asp-route-search="@Model.SearchTerm" asp-fragment="latest-records" title="หน้าถัดไป" aria-label="หน้าถัดไป">›</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

