@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (ViewData["DuplicateAuthenticationCode"] is string duplicateAuthenticationCode)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                smartClinicStatusModal.show({
                    type: 'warning',
                    subtitle: 'OPD Authentication Code',
                    state: 'Duplicate',
                    stateDescription: 'ไม่สามารถบันทึกข้อมูลซ้ำได้',
                    message: 'Authentication Code นี้ถูกใช้กับเวชระเบียน OPD รายการอื่นแล้ว กรุณาตรวจสอบหรือระบุรหัสใหม่',
                    meta: 'Authentication Code: @duplicateAuthenticationCode',
                    actionText: 'กลับไปตรวจสอบ'
                });
            });
        </script>
    }
    <script>
        (function () {
            const patientSearchBox = document.getElementById('patientSearchBox');
            const patientResults = document.getElementById('patientSearchResults');
            const patientIdInput = document.getElementById('medicalPatientId');
            const citizenIdInput = document.getElementById('medicalCitizenId');
            const selectedPatientText = document.getElementById('selectedPatientText');
            const pdfInput = document.getElementById('opdPdfFile');
            const previewSelectedPdfButton = document.getElementById('previewSelectedPdfButton');
            const childToggle = document.getElementById('isChildCase');
            const childFields = document.getElementById('childCaseFields');
            let searchTimer = null;
            let selectedPdfUrl = null;

            function setValue(id, value) {
                const element = document.getElementById(id);
                if (element) element.value = value || '';
            }

            function toggleChildFields() {
                if (childFields) childFields.style.display = childToggle && childToggle.checked ? '' : 'none';
            }

            childToggle?.addEventListener('change', toggleChildFields);
            toggleChildFields();

            const followUpNoneChoice=document.getElementById('followUpNone'),followUpPhoneChoice=document.getElementById('followUpPhone'),followUpClinic=document.getElementById('followUpClinic'),followUpOtherChoice=document.getElementById('followUpOther'),appointmentValue=document.getElementById('followUpAppointmentDateTime'),appointmentButton=document.getElementById('openAppointmentPicker'),appointmentText=document.getElementById('appointmentPickerText'),appointmentDate=document.getElementById('appointmentDate'),appointmentTime=document.getElementById('appointmentTime'),appointmentPreview=document.querySelector('#appointmentPreview strong'),saveAppointment=document.getElementById('saveAppointment'),appointmentModalElement=document.getElementById('appointmentModal');
            const appointmentModal=appointmentModalElement?bootstrap.Modal.getOrCreateInstance(appointmentModalElement):null;
            function formatAppointment(value){if(!value)return null;const date=new Date(value);if(Number.isNaN(date.getTime()))return null;return new Intl.DateTimeFormat('th-TH',{dateStyle:'long',timeStyle:'short'}).format(date)+' น.'}
            function refreshAppointment(){const text=formatAppointment(appointmentValue?.value);appointmentText.textContent=text||'เลือกวันและเวลานัด';appointmentButton?.classList.toggle('selected',!!text);if(appointmentButton)appointmentButton.disabled=!followUpClinic?.checked}
            function openAppointment(){const current=(appointmentValue?.value||'').slice(0,16);if(current){const parts=current.split('T');appointmentDate.value=parts[0]||'';appointmentTime.value=parts[1]||''}else{const soon=new Date(Date.now()+24*60*60*1000);appointmentDate.value=soon.toISOString().slice(0,10);appointmentTime.value='09:00'}appointmentDate.min=new Date().toISOString().slice(0,10);updateAppointmentPreview();appointmentModal?.show()}
            function updateAppointmentPreview(){const value=appointmentDate.value&&appointmentTime.value?`${appointmentDate.value}T${appointmentTime.value}`:'';appointmentPreview.textContent=formatAppointment(value)||'กรุณาเลือกวันที่และเวลา'}
            const followUpChoices=[followUpNoneChoice,followUpPhoneChoice,followUpClinic,followUpOtherChoice].filter(Boolean);
            followUpChoices.forEach(choice=>choice.addEventListener('change',()=>{if(choice.checked){followUpChoices.forEach(other=>{if(other!==choice)other.checked=false})}if(!followUpClinic.checked){appointmentValue.value='';refreshAppointment()}else if(choice===followUpClinic&&!appointmentValue.value){openAppointment()}refreshAppointment()}));
            const initiallyChecked=[followUpClinic,followUpPhoneChoice,followUpOtherChoice,followUpNoneChoice].find(choice=>choice?.checked);if(initiallyChecked)followUpChoices.forEach(choice=>{if(choice!==initiallyChecked)choice.checked=false});refreshAppointment();
            appointmentButton?.addEventListener('click',openAppointment);appointmentDate?.addEventListener('input',updateAppointmentPreview);appointmentTime?.addEventListener('input',updateAppointmentPreview);
            saveAppointment?.addEventListener('click',()=>{if(!appointmentDate.value||!appointmentTime.value){appointmentDate.reportValidity();appointmentTime.reportValidity();return}appointmentValue.value=`${appointmentDate.value}T${appointmentTime.value}`;refreshAppointment();appointmentModal?.hide()});refreshAppointment();

            function selectPatient(item) {
                if (!item) return;
                patientIdInput.value = item.id;
                citizenIdInput.value = item.citizenId;
                setValue('serviceRecipientId', item.serviceRecipientId);
                setValue('authenticationCode', '');
                patientSearchBox.value = item.fullName;
                selectedPatientText.textContent = item.text || `${item.fullName} (${item.citizenId})`;
                patientResults.style.display = 'none';
            }

            async function searchPatientFromPdf(patientName) {
                const query = (patientName || '').trim();
                if (!query || query.length < 2) return;

                patientSearchBox.value = query;
                patientIdInput.value = '';
                citizenIdInput.value = '';
                selectedPatientText.textContent = 'กำลังค้นหาผู้ป่วยจากชื่อใน PDF...';

                const response = await fetch(`/MedicalRecords/SearchPatients?q=${encodeURIComponent(query)}`);
                const items = await response.json();

                if (!items.length) {
                    patientResults.innerHTML = '<div class="list-group-item text-body-secondary">ไม่พบผู้ป่วยจากชื่อใน PDF</div>';
                    patientResults.style.display = '';
                    selectedPatientText.textContent = 'ไม่พบผู้ป่วยจากชื่อใน PDF';
                    return;
                }

                const normalizedQuery = query.replace(/\s+/g, ' ').trim();
                const exactMatch = items.find(item => (item.fullName || '').replace(/\s+/g, ' ').trim() === normalizedQuery);
                if (exactMatch || items.length === 1) {
                    selectPatient(exactMatch || items[0]);
                    return;
                }

                patientResults.innerHTML = '';
                items.forEach(function (item) {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'list-group-item list-group-item-action';
                    button.innerHTML = `<div class="fw-semibold">${item.fullName}</div><div class="small text-body-secondary">${item.citizenId}</div>`;
                    button.addEventListener('click', function () {
                        selectPatient(item);
                    });
                    patientResults.appendChild(button);
                });
                patientResults.style.display = '';
                selectedPatientText.textContent = 'พบหลายรายการ กรุณาเลือกผู้ป่วย';
            }

            patientSearchBox?.addEventListener('input', function () {
                const query = patientSearchBox.value.trim();
                patientIdInput.value = '';
                citizenIdInput.value = '';
                selectedPatientText.textContent = 'ยังไม่ได้เลือกผู้ป่วย';
                window.clearTimeout(searchTimer);

                if (query.length < 2) {
                    patientResults.style.display = 'none';
                    patientResults.innerHTML = '';
                    return;
                }

                searchTimer = window.setTimeout(async function () {
                    const response = await fetch(`/MedicalRecords/SearchPatients?q=${encodeURIComponent(query)}`);
                    const items = await response.json();
                    patientResults.innerHTML = '';

                    if (!items.length) {
                        patientResults.innerHTML = '<div class="list-group-item text-body-secondary">ไม่พบผู้ป่วย</div>';
                        patientResults.style.display = '';
                        return;
                    }

                    items.forEach(function (item) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'list-group-item list-group-item-action';
                        button.innerHTML = `<div class="fw-semibold">${item.fullName}</div><div class="small text-body-secondary">${item.citizenId}</div>`;
                        button.addEventListener('click', function () {
                            selectPatient(item);
                        });
                        patientResults.appendChild(button);
                    });
                    patientResults.style.display = '';
                }, 250);
            });

            const primaryIcdInput = document.getElementById('diagnosisInput');
            const primaryIcdCode = document.getElementById('primaryIcd10Code');
            const primaryIcdResults = document.getElementById('primaryIcdResults');
            const primaryIcdSelected = document.getElementById('primaryIcdSelected');
            const differentialIcdSearch = document.getElementById('differentialIcdSearch');
            const differentialIcdCodes = document.getElementById('differentialIcd10Codes');
            const differentialIcdResults = document.getElementById('differentialIcdResults');
            const differentialIcdSelected = document.getElementById('differentialIcdSelected');
            let icdTimer;
            const icdLabels = new Map();

            function createIcdResult(item, onSelect) {
                const button = document.createElement('button'); button.type = 'button'; button.className = 'icd-result-item';
                const code = document.createElement('strong'); code.textContent = item.displayCode || item.code;
                const names = document.createElement('span'); names.textContent = item.thaiName || item.englishName;
                const english = document.createElement('small'); english.textContent = [item.englishName, item.blockCode, item.blockTitle].filter(Boolean).join(' · ');
                button.append(code, names, english); button.addEventListener('click', () => onSelect(item)); return button;
            }
            async function searchIcd(query, results, onSelect) {
                window.clearTimeout(icdTimer); const term = (query || '').trim();
                if (!term) { results.hidden = true; results.replaceChildren(); return; }
                icdTimer = window.setTimeout(async () => {
                    const response = await fetch(`/MedicalRecords/SearchIcd10?q=${encodeURIComponent(term)}`);
                    const items = await response.json(); results.replaceChildren();
                    if (!items.length) { const empty=document.createElement('div');empty.className='icd-result-empty';empty.textContent='ไม่พบรหัส ICD-10 ที่ตรงกัน';results.append(empty); }
                    else items.forEach(item => results.append(createIcdResult(item, onSelect)));
                    results.hidden = false;
                }, 220);
            }
            function renderPrimary(item) {
                primaryIcdCode.value = item?.code || ''; primaryIcdSelected.replaceChildren();
                if (!item?.code) return; icdLabels.set(item.code, item); const chip=document.createElement('span');chip.className='icd-chip primary';chip.textContent=`หลัก · ${item.code} · ${item.thaiName || item.englishName}`;primaryIcdSelected.append(chip);
            }
            function renderDifferential() {
                differentialIcdSelected.replaceChildren(); const codes=(differentialIcdCodes.value||'').split(',').filter(Boolean);
                codes.forEach(code => { const item=icdLabels.get(code)||{code,thaiName:''};const chip=document.createElement('span');chip.className='icd-chip';const text=document.createElement('span');text.textContent=`${code}${item.thaiName?' · '+item.thaiName:''}`;const remove=document.createElement('button');remove.type='button';remove.setAttribute('aria-label',`ลบ ${code}`);remove.textContent='×';remove.onclick=()=>{differentialIcdCodes.value=codes.filter(x=>x!==code).join(',');renderDifferential()};chip.append(text,remove);differentialIcdSelected.append(chip); });
            }
            function syncDiagnosisSummary() {
                const codes=[primaryIcdCode.value,...(differentialIcdCodes.value||'').split(',')].filter(Boolean);
                const names=codes.map(code=>{const name=icdLabels.get(code)?.englishName;return name?`${code} - ${name}`:null}).filter(Boolean);
                if (names.length) document.getElementById('initialDifferentialDiagnosis').value=[...new Set(names)].join(', ');
            }
            function selectPrimary(item, updateSummary = true) { primaryIcdInput.value = `${item.thaiName || item.englishName} - ${item.code}`; renderPrimary(item); primaryIcdResults.hidden=true; if(updateSummary)syncDiagnosisSummary(); }
            function selectDifferential(item, updateSummary = true) { icdLabels.set(item.code,item);const codes=(differentialIcdCodes.value||'').split(',').filter(Boolean);if(!codes.includes(item.code))codes.push(item.code);differentialIcdCodes.value=codes.join(',');differentialIcdSearch.value='';differentialIcdResults.hidden=true;renderDifferential();if(updateSummary)syncDiagnosisSummary(); }
            primaryIcdInput?.addEventListener('input', () => { if (primaryIcdCode.value) renderPrimary(null); searchIcd(primaryIcdInput.value, primaryIcdResults, selectPrimary); });
            differentialIcdSearch?.addEventListener('input', () => searchIcd(differentialIcdSearch.value, differentialIcdResults, selectDifferential));
            document.addEventListener('click', e => { if (!e.target.closest('.icd-autocomplete')) { primaryIcdResults.hidden=true; differentialIcdResults.hidden=true; } });
            if (primaryIcdCode?.value) renderPrimary({code:primaryIcdCode.value,thaiName:''}); renderDifferential();
            async function matchPdfIcd(text, differential) {
                if (!text) return; const response=await fetch(`/MedicalRecords/MatchIcd10?text=${encodeURIComponent(text)}`);const items=await response.json();
                if (!items.length) return; if (differential) items.forEach(item=>selectDifferential(item,false)); else renderPrimary(items[0]);
            }

            const weightInput=document.getElementById('weightKilograms'),heightInput=document.getElementById('heightCentimeters'),bmiInput=document.getElementById('bodyMassIndex'),bmiValue=document.getElementById('bmiValue'),bmiCategory=document.getElementById('bmiCategory'),bmiResult=document.getElementById('bmiResult');
            function calculateBmi(){const weight=parseFloat(weightInput?.value),height=parseFloat(heightInput?.value)/100;if(!weight||!height){bmiInput.value='';bmiValue.textContent='-';bmiCategory.textContent='กรอกน้ำหนักและส่วนสูงเพื่อคำนวณ';bmiResult.dataset.level='';return}const bmi=weight/(height*height);bmiInput.value=bmi.toFixed(2);bmiValue.textContent=bmi.toFixed(2);let label='น้ำหนักปกติ',level='normal';if(bmi<18.5){label='น้ำหนักต่ำกว่าเกณฑ์';level='low'}else if(bmi>=30){label='อ้วน';level='high'}else if(bmi>=25){label='น้ำหนักเกิน';level='warn'}bmiCategory.textContent=label;bmiResult.dataset.level=level}
            weightInput?.addEventListener('input',calculateBmi);heightInput?.addEventListener('input',calculateBmi);calculateBmi();

            pdfInput?.addEventListener('change', function () {
                if (selectedPdfUrl) URL.revokeObjectURL(selectedPdfUrl);
                const file = pdfInput.files && pdfInput.files[0];
                selectedPdfUrl = file ? URL.createObjectURL(file) : null;
                if (previewSelectedPdfButton) previewSelectedPdfButton.disabled = !selectedPdfUrl;
            });

            previewSelectedPdfButton?.addEventListener('click', function () {
                if (!selectedPdfUrl) return;
                const modalElement = document.getElementById('pdfPreviewModal');
                const iframe = document.getElementById('pdfPreviewFrame');
                const label = document.getElementById('pdfPreviewLabel');
                if (iframe) iframe.src = selectedPdfUrl;
                if (label) label.textContent = 'PDF ที่เลือก';
                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            });

            document.querySelector('[data-medical-pdf-import]')?.addEventListener('click', async function (event) {
                const file = pdfInput?.files?.[0];
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!file) {
                    smartClinicStatusModal.show({
                        type: 'warning',
                        subtitle: 'PDF import',
                        state: 'No file',
                        stateDescription: 'ยังไม่ได้เลือกไฟล์',
                        message: 'กรุณาเลือกไฟล์ PDF ก่อนอ่านข้อมูล',
                        actionText: 'ปิด'
                    });
                    return;
                }

                const formData = new FormData();
                formData.append('opdPdfFile', file);
                event.currentTarget.disabled = true;

                try {
                    const response = await fetch('/MedicalRecords/ImportPdf', {
                        method: 'POST',
                        headers: token ? { RequestVerificationToken: token.value } : {},
                        body: formData
                    });
                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.error || `HTTP ${response.status}`);
                    }

                    const data = payload.data || {};
                    await searchPatientFromPdf(data.patientName);
                    setValue('serviceRecipientId', data.serviceRecipientId);
                    setValue('visitDateInput', data.visitDate);
                    setValue('authenticationCode', data.authenticationCode);
                    setValue('diagnosisInput', data.diagnosis);
                    setValue('initialDifferentialDiagnosis', data.initialDifferentialDiagnosis);
                    renderPrimary(null); differentialIcdCodes.value = ''; renderDifferential();
                    await matchPdfIcd(data.diagnosis, false);
                    await matchPdfIcd(data.initialDifferentialDiagnosis, true);
                    setValue('chiefComplaint', data.chiefComplaint);
                    setValue('presentIllness', data.presentIllness);
                    setValue('physicalExam', data.physicalExam);
                    setValue('temperatureCelsius', data.temperatureCelsius);
                    setValue('pulseRate', data.pulseRate);
                    setValue('respiratoryRate', data.respiratoryRate);
                    setValue('systolicPressure', data.systolicPressure);
                    setValue('diastolicPressure', data.diastolicPressure);
                    setValue('weightKilograms', data.weightKilograms);
                    setValue('heightCentimeters', data.heightCentimeters);
                    calculateBmi();
                    setValue('problemPhysicalExam', data.problemPhysicalExam);
                    setValue('treatmentAndAdvice', data.treatmentAndAdvice);
                    setValue('referralDetail', data.referralDetail);
                    setValue('followUpClinicNote', data.followUpClinicNote);
                    setValue('followUpOtherNote', data.followUpOtherNote);
                    setValue('serviceEndDateTime', data.serviceEndDateTime);
                    const followUpNone = document.getElementById('followUpNone');
                    const followUpPhone = document.getElementById('followUpPhone');
                    const followUpClinic = document.getElementById('followUpClinic');
                    const followUpOther = document.getElementById('followUpOther');
                    if (followUpNone) followUpNone.checked = data.followUpNone === true;
                    if (followUpPhone) followUpPhone.checked = data.followUpPhone === true;
                    if (followUpClinic) followUpClinic.checked = data.followUpClinic === true;
                    if (followUpOther) followUpOther.checked = data.followUpOther === true;
                    const childGrowth = document.querySelector('[name="Input.ChildGrowthStatus"]');
                    const childDevelopment = document.querySelector('[name="Input.ChildDevelopmentStatus"]');
                    const childVaccine = document.querySelector('[name="Input.ChildVaccineStatus"]');
                    const childVaccineNote = document.querySelector('[name="Input.ChildVaccineNote"]');
                    if (childGrowth) childGrowth.value = data.childGrowthStatus || '';
                    if (childDevelopment) childDevelopment.value = data.childDevelopmentStatus || '';
                    if (childVaccine) childVaccine.value = data.childVaccineStatus || '';
                    if (childVaccineNote) childVaccineNote.value = data.childVaccineNote || '';

                    if (childToggle) {
                        childToggle.checked = data.isChildCase === true;
                        toggleChildFields();
                    }

                    smartClinicStatusModal.show({
                        type: 'success',
                        subtitle: 'PDF import',
                        state: 'Completed',
                        stateDescription: 'อ่านข้อมูลจาก PDF สำเร็จ',
                        message: 'ระบบเติมข้อมูล OPD จาก PDF แล้ว กรุณาตรวจทานก่อนบันทึก',
                        meta: data.authenticationCode ? `Authentication Code: ${data.authenticationCode}` : 'medical-record-pdf',
                        actionText: 'ตกลง'
                    });
                } catch (error) {
                    smartClinicStatusModal.show({
                        type: 'danger',
                        subtitle: 'PDF import',
                        state: 'Failed',
                        stateDescription: 'อ่าน PDF ไม่สำเร็จ',
                        message: error.message,
                        actionText: 'ปิด'
                    });
                } finally {
                    event.currentTarget.disabled = false;
                }
            });
        })();
    </script>

    @if ((TempData["StatusModal"] as string) == "record-created")
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                smartClinicStatusModal.show({
                    type: 'success',
                    subtitle: 'Medical record update',
                    state: 'Saved',
                    stateDescription: 'บันทึกข้อมูลเรียบร้อย',
                    message: 'ระบบบันทึก OPD Card PDF และรายละเอียดการรักษาลงฐานข้อมูลแล้ว',
                    meta: 'PDF stored in SQL Server',
                    actionText: 'Close'
                });
            });
        </script>
    }
    else if ((TempData["StatusModal"] as string) == "record-updated")
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                smartClinicStatusModal.show({
                    type: 'success',
                    subtitle: 'Medical record',
                    state: 'Updated',
                    stateDescription: 'แก้ไขข้อมูลเรียบร้อย',
                    message: 'ระบบบันทึกการแก้ไขประวัติการรักษาลงฐานข้อมูลแล้ว',
                    actionText: 'ปิด'
                });
            });
        </script>
    }
    else if ((TempData["StatusModal"] as string) == "record-deleted")
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                smartClinicStatusModal.show({
                    type: 'success',
                    subtitle: 'Medical record',
                    state: 'Deleted',
                    stateDescription: 'ลบข้อมูลเรียบร้อย',
                    message: 'ระบบลบประวัติการรักษาที่เลือกออกจากฐานข้อมูลแล้ว',
                    actionText: 'ปิด'
                });
            });
        </script>
    }
}
