@model DrugAdviceDashboardViewModel
@{ ViewData["Title"] = "คลังคำแนะนำ"; var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("AdminClinic"); }
<link rel="stylesheet" href="~/css/drug-catalog.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-import.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-import-review.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-import-per-item.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-reports.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-icd-autocomplete.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-advice.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-card-grid.css" asp-append-version="true" />

<div class="advice-page">
    <header class="advice-hero">
        <div><span>CLINICAL ADVICE</span><h1>คลังคำแนะนำ</h1><p>จัดลำดับคำแนะนำ คำเตือน และการติดตาม แยกตามรหัส ICD‑10</p></div>
        <div class="advice-stats"><div><strong>@Model.ActiveCount</strong><small>ใช้งาน</small></div><div class="warning"><strong>@Model.WarningCount</strong><small>คำเตือน</small></div><div><strong>@Model.FollowUpCount</strong><small>ติดตาม</small></div></div>
    </header>

    <section class="drug-toolbar advice-toolbar">
        <form method="get"><input name="q" value="@Model.SearchTerm" placeholder="ค้นหาข้อความคำแนะนำ"/><input name="icd" value="@Model.Icd10Code" placeholder="กรอง ICD-10"/><select name="category"><option value="">ทุกประเภท</option><option value="General" selected="@(Model.Category=="General"?"selected":null)">ทั่วไป</option><option value="Warning" selected="@(Model.Category=="Warning"?"selected":null)">คำเตือน</option><option value="FollowUp" selected="@(Model.Category=="FollowUp"?"selected":null)">การติดตาม</option></select><button class="btn btn-primary">ค้นหา</button><a asp-action="Index" class="btn btn-light">ล้าง</a></form>
        <button type="button" class="btn btn-outline-secondary audit-preview-button" data-bs-toggle="modal" data-bs-target="#adviceAuditModal"><span>↺</span> ประวัติการเปลี่ยนแปลง</button>
        @if(canManage){<button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#opdAdviceImportModal">นำเข้าจาก OPD</button><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#adviceModal">+ เพิ่มคำแนะนำ</button>}
    </section>

    <section class="advice-order-summary"><span class="order-summary-icon">↕</span><div><strong>การเรียงลำดับคำแนะนำ</strong><p>เลขน้อยแสดงก่อน เช่น 0 → 10 → 20 → 30 และหากเลขเท่ากันระบบจะเรียงตามข้อมูลเดิมในฐานข้อมูล</p></div></section>

    <section class="advice-list-panel">
        <header><div><span>ADVICE MASTER</span><h2>รายการคำแนะนำตามโรค</h2></div><small>@Model.Items.Count รายการที่แสดง</small></header>
        <div class="advice-table-wrap"><table class="advice-table"><thead><tr><th>ลำดับ</th><th>ICD‑10 / ชื่อโรคไทย</th><th>ประเภท</th><th>ข้อความคำแนะนำ</th><th>สถานะ</th><th>แก้ไขล่าสุด</th><th>จัดการ</th></tr></thead><tbody>
        @foreach(var item in Model.Items){<tr class="@(!item.IsActive?"inactive":"")"><td><span class="order-badge"><small>ลำดับ</small><strong>@item.DisplayOrder</strong></span></td><td class="disease-cell"><b>@item.Icd10Code</b><span>@(Model.Icd10ThaiNames.TryGetValue(item.Icd10Code,out var thaiName)?thaiName:"ไม่พบชื่อโรคภาษาไทย")</span></td><td><span class="advice-type @item.Category.ToLowerInvariant()">@(item.Category=="Warning"?"คำเตือน":item.Category=="FollowUp"?"การติดตาม":"ทั่วไป")</span></td><td class="advice-copy">@item.Text</td><td><span class="advice-status @(item.IsActive?"active":"inactive")">@(item.IsActive?"ใช้งาน":"ปิดใช้งาน")</span></td><td class="updated-cell">@item.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")<small>@item.UpdatedAtUtc.ToLocalTime().ToString("HH:mm") น.</small></td><td class="advice-actions">@if(canManage){<button type="button" class="btn btn-sm btn-outline-primary" data-edit-advice data-id="@item.Id" data-icd="@item.Icd10Code" data-category="@item.Category" data-text="@item.Text" data-order="@item.DisplayOrder" data-bs-toggle="modal" data-bs-target="#adviceModal">แก้ไข</button><form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-secondary">@(item.IsActive?"ปิด":"เปิด")</button></form><form asp-action="Delete" method="post" onsubmit="return confirm('ยืนยันลบคำแนะนำรายการนี้?');"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-danger">ลบ</button></form>}</td></tr>}
        @if(Model.Items.Count==0){<tr><td colspan="7" class="advice-empty">ยังไม่พบคำแนะนำตามเงื่อนไขที่ค้นหา</td></tr>}
        </tbody></table></div>
    </section>

</div>

<div class="modal fade audit-preview-modal" id="adviceAuditModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><small>ADVICE AUDIT PREVIEW</small><h2 class="modal-title">ประวัติการเปลี่ยนแปลงคำแนะนำ</h2><p>ประวัติการเพิ่ม แก้ไข เปิด/ปิด และลบคำแนะนำล่าสุด @Model.RecentAudit.Count รายการ</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="audit-preview-toolbar"><span>↺ ข้อมูลล่าสุดของคลังคำแนะนำ</span><input type="search" class="form-control" data-audit-search="adviceAuditRows" placeholder="ค้นหาการกระทำ รายละเอียด หรือผู้ดำเนินการ"/></div><div class="report-table-wrap"><table class="catalog-report-table"><thead><tr><th>วันเวลา</th><th>การกระทำ</th><th>รายละเอียด</th><th>ผู้ดำเนินการ</th></tr></thead><tbody id="adviceAuditRows">@foreach(var log in Model.RecentAudit){<tr><td class="nowrap">@log.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="audit-action">@log.Action</span></td><td class="audit-detail">@log.Detail</td><td>@(string.IsNullOrWhiteSpace(log.UserName)?"ระบบ":log.UserName)</td></tr>}@if(Model.RecentAudit.Count==0){<tr><td colspan="4" class="report-empty">ยังไม่มีประวัติการเปลี่ยนแปลงคำแนะนำ</td></tr>}</tbody></table></div></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">ปิดหน้าต่าง</button></div></div></div></div>

@if(canManage){
<div class="modal fade" id="adviceModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content drug-modal advice-edit-modal"><form asp-action="Save" method="post" id="adviceForm"><div class="modal-header"><div><small>ADVICE MASTER</small><h2 class="modal-title" id="adviceModalTitle">เพิ่มคำแนะนำตามโรค</h2><p>กำหนดข้อความและลำดับการแสดงผลสำหรับ ICD‑10</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="Id" id="adviceId"/><label>รหัส ICD‑10 *</label><input name="Icd10Code" id="adviceIcd" class="form-control mb-3" required/><label>ประเภทคำแนะนำ</label><select name="Category" id="adviceCategory" class="form-select mb-3"><option value="General">ทั่วไป</option><option value="Warning">คำเตือน</option><option value="FollowUp">การติดตาม</option></select><label>ข้อความคำแนะนำ *</label><textarea name="Text" id="adviceText" class="form-control mb-3" rows="5" required></textarea><label>ลำดับการแสดงผล</label><input name="DisplayOrder" id="adviceOrder" type="number" class="form-control" value="0"/><small class="order-field-hint">เลขน้อยแสดงก่อน</small><aside class="order-guide"><header><span>↕</span><div><strong>“ลำดับการแสดงผล” คืออะไร?</strong><p>ใช้กำหนดว่าคำแนะนำใดจะแสดงก่อนหรือหลัง เมื่อ ICD‑10 เดียวกันมีหลายคำแนะนำ</p></div></header><ul><li><b>0</b><span>คำแนะนำการรับประทานยา</span></li><li><b>10</b><span>การพักผ่อน</span></li><li><b>20</b><span>อาหารและน้ำดื่ม</span></li><li><b>30</b><span>อาการผิดปกติที่ควรพบแพทย์</span></li></ul><p>ค่าน้อยแสดงก่อน ค่ามากแสดงทีหลัง และหากค่าเท่ากันระบบจะเรียงตามข้อมูลเดิมในฐานข้อมูล ตัวอย่างนี้ใช้กับ J039 และสามารถประยุกต์กับโรคอื่นได้</p></aside></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button class="btn btn-primary">บันทึก</button></div></form></div></div></div>
<div class="modal fade" id="opdAdviceImportModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content drug-modal advice-import-modal"><div class="modal-header"><div><small>OPD ADVICE IMPORT</small><h2 class="modal-title">ตรวจสอบคำแนะนำทั่วไปจาก OPD</h2><p>ตรวจข้อความ ประเภท รหัส ICD‑10 และชื่อโรคภาษาไทยก่อนบันทึก</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="opdAdviceImportState" class="drug-import-state">กด “ตรวจสอบคำแนะนำ” เพื่อสแกน OPD เดิม</div><div class="drug-import-actions"><button type="button" class="btn btn-outline-primary" id="loadOpdAdviceImport">ตรวจสอบคำแนะนำ</button><label><input type="checkbox" id="selectAllAdviceImports"/> เลือกคำแนะนำทั้งหมด</label></div><div class="drug-advice-review" id="opdAdviceRows"></div></div><div class="modal-footer"><span id="opdAdviceImportSummary"></span><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button type="button" class="btn btn-primary" id="commitOpdAdviceImport">บันทึกคำแนะนำที่เลือก</button></div></div></div></div>
<div hidden aria-hidden="true"><div id="opdImportState"></div><span id="opdImportSummary"></span><div id="opdImportRows"></div><button id="loadOpdImport" type="button"></button><input id="selectAllImports" type="checkbox"/><div id="opdImportWarnings"></div></div>
<div class="drug-save-report-backdrop" id="drugSaveReportPopup" hidden><section class="drug-save-report" role="dialog" aria-modal="true" aria-labelledby="drugSaveReportTitle"><header><span class="save-report-check">✓</span><div><small id="saveReportEyebrow">ADVICE SAVE COMPLETED</small><h2 id="drugSaveReportTitle">บันทึกคำแนะนำเรียบร้อย</h2><p id="saveReportDescription">ระบบตรวจสอบและเชื่อมคำแนะนำกับโรคแล้ว</p></div></header><div class="save-report-drug"><span id="saveReportItemLabel">คำแนะนำที่บันทึก</span><strong id="saveReportDrugName">-</strong></div><div class="save-report-grid"><div><span>ผลการบันทึก</span><strong id="saveReportStatus">-</strong></div><div><span id="saveReportLinkedLabel">ความสัมพันธ์กับโรค</span><strong id="saveReportLinked">0 รายการ</strong></div><div><span>รหัสโรค</span><strong id="saveReportCodes">-</strong></div><div><span>วันเวลา</span><strong id="saveReportTime">-</strong></div></div><footer><button type="button" class="btn btn-primary" id="closeDrugSaveReport">ทำรายการต่อ</button></footer></section></div>
}

@section Scripts{
<script src="~/js/drug-catalog-import.js" asp-append-version="true"></script>
<script src="~/js/drug-catalog-icd-autocomplete.js" asp-append-version="true"></script>
<script src="~/js/catalog-audit-preview.js" asp-append-version="true"></script>
<script>document.getElementById('adviceModal')?.addEventListener('show.bs.modal',event=>{const button=event.relatedTarget,isEdit=button?.hasAttribute('data-edit-advice');document.getElementById('adviceModalTitle').textContent=isEdit?'แก้ไขคำแนะนำตามโรค':'เพิ่มคำแนะนำตามโรค';document.getElementById('adviceId').value=isEdit?button.dataset.id:'';document.getElementById('adviceIcd').value=isEdit?button.dataset.icd:'';document.getElementById('adviceCategory').value=isEdit?button.dataset.category:'General';document.getElementById('adviceText').value=isEdit?button.dataset.text:'';document.getElementById('adviceOrder').value=isEdit?button.dataset.order:'0'});</script>
}
