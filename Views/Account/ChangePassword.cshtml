@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center auth-shell">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 mt-4 auth-card">
            <div class="card-body p-4 p-lg-5">
                <div class="auth-mark">SC</div>
                <div class="text-uppercase text-primary small fw-bold mb-2">Account security</div>
                <h1 class="h3 fw-bold mb-3">ตั้งรหัสผ่านใหม่</h1>
                <p class="text-body-secondary">เพื่อความปลอดภัย กรุณาเปลี่ยนรหัสผ่านก่อนใช้งานระบบต่อ</p>
                <form asp-action="ChangePassword" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control form-control-lg" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control form-control-lg" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">บันทึกรหัสผ่านใหม่</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
