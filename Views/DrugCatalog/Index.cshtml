@if(canManage){<div class="modal fade" id="opdImportModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content drug-modal"><div class="modal-header"><div><small>OPD DRUG IMPORT</small><h2 class="modal-title">ตรวจสอบรายการยาจาก OPD</h2><p>ตรวจข้อมูลยา วิธีใช้ และเลือกได้ว่าจะผูก ICD‑10 ที่ตรวจพบพร้อมกันหรือบันทึกเฉพาะยา</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="opdImportState" class="drug-import-state">กด “ตรวจสอบข้อมูล” เพื่อสแกน OPD เดิม</div><div id="opdImportWarnings" class="opd-parse-warnings" hidden></div><div class="drug-import-actions"><button type="button" class="btn btn-outline-primary" id="loadOpdImport">แยกและตรวจสอบยา</button><label><input type="checkbox" id="selectAllImports"/> เลือกรายการที่ต้องดำเนินการทั้งหมด</label></div><h3 class="drug-import-title">ยาใหม่จาก OPD <small>ตรวจรหัสโรคแล้วเลือกผูกกับยาเป็นรายตัวได้</small></h3><div class="drug-import-cards" id="opdImportRows"></div></div><div class="modal-footer"><span id="opdImportSummary"></span><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button type="button" class="btn btn-primary" id="commitOpdImport">ยืนยันบันทึกยาที่เลือก</button></div></div></div></div><div class="modal fade" id="opdAdviceImportModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content drug-modal advice-import-modal"><div class="modal-header"><div><small>OPD ADVICE IMPORT</small><h2 class="modal-title">ตรวจสอบคำแนะนำทั่วไป</h2><p>แยกจากรายการยา พร้อมแสดงรหัส ICD-10 และชื่อโรคภาษาไทยก่อนบันทึก</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="opdAdviceImportState" class="drug-import-state">กด “ตรวจสอบคำแนะนำ” เพื่อสแกน OPD เดิม</div><div class="drug-import-actions"><button type="button" class="btn btn-outline-primary" id="loadOpdAdviceImport">ตรวจสอบคำแนะนำ</button><label><input type="checkbox" id="selectAllAdviceImports"/> เลือกคำแนะนำทั้งหมด</label></div><h3 class="drug-import-title">คำแนะนำทั่วไป <small>ตรวจข้อความ ประเภท และโรคภาษาไทยก่อนบันทึก</small></h3><div class="drug-advice-review" id="opdAdviceRows"></div></div><div class="modal-footer"><span id="opdAdviceImportSummary"></span><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button type="button" class="btn btn-primary" id="commitOpdAdviceImport">บันทึกคำแนะนำที่เลือก</button></div></div></div></div>}
<div class="modal fade" id="externalDrugModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content drug-modal"><div class="modal-header"><div><small>OFFICIAL SOURCES / API</small><h2 class="modal-title">ค้นหาฐานข้อมูลยาไทย</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><label>ชื่อยา ชื่อการค้า หรือสารสำคัญ</label><div class="input-group"><input id="externalDrugQuery" class="form-control form-control-lg" placeholder="เช่น paracetamol"/><button type="button" class="btn btn-primary" id="externalDrugSearch">ค้นหาผ่าน API</button></div><div id="externalDrugState" class="drug-import-state">API Adapter พร้อมใช้งานเมื่อกำหนด URL และ API Key ของหน่วยงานเจ้าของข้อมูล</div><div id="externalDrugResults" class="external-api-results"></div><div class="external-source-grid"><a href="https://pertento.fda.moph.go.th/fda_search_drug/SEARCH_DRUG/FRM_SEARCH_DRUG.aspx" target="_blank" rel="noopener"><strong>อย.</strong><span>ทะเบียนผลิตภัณฑ์ยา</span></a><a href="https://ndi.fda.moph.go.th/drug_info_corporation/char/A/443" target="_blank" rel="noopener"><strong>NDI</strong><span>ชื่อสามัญ ความแรง และรูปแบบ</span></a><a href="https://this.or.th/service/tmt/" target="_blank" rel="noopener"><strong>TMT</strong><span>รหัสยามาตรฐานไทย</span></a></div><div class="external-warning">ข้อมูลภายนอกใช้เพื่อช่วยค้นหาเท่านั้น ผู้ให้บริการต้องตรวจสอบและยืนยันก่อนนำเข้าคลังหรือใช้กับผู้ป่วย</div></div></div></div></div>
@if(canManage){<div class="drug-save-report-backdrop" id="drugSaveReportPopup" hidden><section class="drug-save-report" role="dialog" aria-modal="true" aria-labelledby="drugSaveReportTitle"><header><span class="save-report-check">✓</span><div><small id="saveReportEyebrow">SAVE COMPLETED</small><h2 id="drugSaveReportTitle">บันทึกรายการยาเรียบร้อย</h2><p id="saveReportDescription">ระบบตรวจสอบข้อมูลและบันทึกเข้าคลังยาของคลินิกแล้ว</p></div></header><div class="save-report-drug"><span id="saveReportItemLabel">รายการที่บันทึก</span><strong id="saveReportDrugName">-</strong></div><div class="save-report-grid"><div><span>ผลการบันทึก</span><strong id="saveReportStatus">-</strong></div><div><span id="saveReportLinkedLabel">เชื่อม ICD-10</span><strong id="saveReportLinked">0 รายการ</strong></div><div><span>รหัสโรค</span><strong id="saveReportCodes">-</strong></div><div><span>วันเวลา</span><strong id="saveReportTime">-</strong></div></div><footer><button type="button" class="btn btn-primary" id="closeDrugSaveReport">ทำรายการต่อ</button></footer></section></div>}
@section Scripts{<script src="~/js/drug-catalog-import.js?v=20260801-6" asp-append-version="true"></script><script src="~/js/drug-catalog-icd-autocomplete.js" asp-append-version="true"></script><script src="~/js/catalog-audit-preview.js" asp-append-version="true"></script><script src="~/js/drug-saved-edit.js" asp-append-version="true"></script><script src="~/js/icd-drug-selection.js" asp-append-version="true"></script><script>
document.getElementById('protocolModal')?.addEventListener('show.bs.modal',e=>{const b=e.relatedTarget;document.getElementById('protocolDrugId').value=b.dataset.drugId;document.getElementById('protocolDrugName').textContent=b.dataset.drugName});
document.getElementById('drugModal')?.addEventListener('show.bs.modal',e=>{const b=e.relatedTarget,form=document.getElementById('drugForm');if(!b)return;const edit=b.hasAttribute('data-edit-drug');if(!edit)form.reset();const set=(name,value)=>form.querySelector(`[name="${name}"]`).value=value||'';set('Id',edit?b.dataset.id:'');set('GenericName',edit?b.dataset.generic:'');set('TradeName',edit?b.dataset.trade:'');set('ManufacturerName',edit?b.dataset.manufacturer:'');set('Strength',edit?b.dataset.strength:'');set('DosageForm',edit?b.dataset.form:'');set('Unit',edit?b.dataset.unit:'');set('TmtCode',edit?b.dataset.tmt:'');set('RegistrationNumber',edit?b.dataset.registration:'');set('Source',edit?b.dataset.source:'Clinic');document.getElementById('drugModalTitle').textContent=edit?'แก้ไขข้อมูลรายการยา':'เพิ่มยาเข้าคลังคลินิก';document.getElementById('drugSaveButton').textContent=edit?'บันทึกการแก้ไข':'บันทึกยา'});
document.getElementById('adviceModal')?.addEventListener('show.bs.modal',e=>{const b=e.relatedTarget,isEdit=b?.hasAttribute('data-edit-advice');document.getElementById('adviceModalTitle').textContent=isEdit?'แก้ไขคำแนะนำตามโรค':'เพิ่มคำแนะนำตามโรค';document.getElementById('adviceId').value=isEdit?b.dataset.id:'';document.getElementById('adviceIcd').value=isEdit?b.dataset.icd:'';document.getElementById('adviceCategory').value=isEdit?b.dataset.category:'General';document.getElementById('adviceText').value=isEdit?b.dataset.text:'';document.getElementById('adviceOrder').value=isEdit?b.dataset.order:'0'});
</script>}
