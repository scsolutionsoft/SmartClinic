@model DrugCatalogDashboardViewModel
@{ ViewData["Title"] = "คลังยา"; var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("AdminClinic"); var drugDisplayIndex = (Model.Page - 1) * Model.PageSize; }
<link rel="stylesheet" href="~/css/drug-catalog.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-import.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-import-review.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-review-card-v2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-import-per-item.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-reports.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-master-details.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-icd-autocomplete.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-sequence.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-catalog-card-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-saved-edit.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-saved-edit-layout.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/icd-drug-selection.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/icd-disease-report.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/drug-search-autocomplete.css" asp-append-version="true" />
<script src="~/js/icd-disease-report.js" asp-append-version="true" defer></script>
<script src="~/js/drug-search-autocomplete.js" asp-append-version="true" defer></script>
<div class="drug-catalog-page">
<header class="drug-catalog-hero"><div><span>DRUG MASTER</span><h1>คลังยา</h1><p>จัดการข้อมูลยา วิธีใช้ และความสัมพันธ์กับรหัส ICD-10 ของคลินิก</p></div><div class="drug-catalog-stats"><div><strong>@Model.ActiveDrugCount</strong><small>ยาที่ใช้งาน</small></div><div><strong>@Model.PendingCount</strong><small>รอตรวจสอบ</small></div><div class="@(Model.DuplicateCandidateCount>0?"warn":"")"><strong>@Model.DuplicateCandidateCount</strong><small>อาจซ้ำ</small></div></div></header>
@if(TempData["DrugCatalogError"] is string error){<div class="alert alert-warning">@error</div>}
@if(TempData["DrugCatalogSuccess"] is string success){<div class="alert alert-success">@success</div>}
<section class="drug-toolbar drug-action-toolbar"><div><strong>จัดการคลังยา</strong><small>เลือกคำสั่งที่ต้องการดำเนินการ</small></div>@if(canManage){<button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#opdImportModal">ดึงยาจาก OPD</button><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#icdDrugSelectionModal">จัดยาตามโรค</button><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#drugModal">+ เพิ่มยา</button>}<button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#externalDrugModal">ค้นหาฐานข้อมูลยาไทย</button></section>
<section class="icd-disease-report-panel">
    <header class="icd-report-heading"><div><span>ICD‑10 MEDICATION REPORT</span><h2>รายงานยาตามโรค</h2><p>รหัสโรค ชื่อภาษาไทย–อังกฤษ และรายการยาที่เชื่อมโยงในคลินิก</p></div><b>@Model.DiseaseDrugReports.Count โรค</b></header>
    <div class="icd-disease-report-grid">
    @if(Model.DiseaseDrugReports.Count==0){<div class="icd-report-empty">ยังไม่มีความสัมพันธ์ระหว่างโรคกับยา กด “จัดยาตามโรค” เพื่อเริ่มเพิ่มข้อมูล</div>}
    @foreach(var disease in Model.DiseaseDrugReports){<article class="icd-disease-report-card"><header><span class="icd-report-code">@disease.Icd10Code</span><div><strong>@disease.ThaiName</strong><small>@disease.EnglishName</small></div><b>@disease.Drugs.Count ยา</b></header><div class="icd-report-drug-list">@foreach(var item in disease.Drugs){<div class="icd-report-drug"><span>Rx</span><div><strong>@item.GenericName @item.Strength</strong><small>@(string.IsNullOrWhiteSpace(item.TradeName)?"ไม่ระบุชื่อการค้า":item.TradeName) · @(string.IsNullOrWhiteSpace(item.ManufacturerName)?"ไม่ระบุบริษัท":item.ManufacturerName) · @item.DosageForm</small><em>@(string.IsNullOrWhiteSpace(item.UsageText)?"ยังไม่ได้ระบุวิธีใช้":item.UsageText)</em></div>@if(canManage){<button type="button" title="แก้ไขข้อมูลยา" data-edit-drug-details data-id="@item.DrugId" data-bs-toggle="modal" data-bs-target="#drugDetailsModal">แก้ไขยา</button>}</div>}</div>@if(canManage){<footer><button type="button" class="btn btn-sm btn-outline-primary" data-icd-report-edit="@disease.Icd10Code" data-bs-toggle="modal" data-bs-target="#icdDrugSelectionModal">แก้ไขรายการ</button><button type="button" class="btn btn-sm btn-primary" data-icd-report-edit="@disease.Icd10Code" data-bs-toggle="modal" data-bs-target="#icdDrugSelectionModal">+ เพิ่มยา</button><form asp-action="DeleteIcdDrugAssignments" method="post" onsubmit="return confirm('ยืนยันลบความสัมพันธ์ยาทั้งหมดของโรค @disease.Icd10Code? ข้อมูลยาในคลังจะไม่ถูกลบ');"><input type="hidden" name="icd10Code" value="@disease.Icd10Code"/><button class="btn btn-sm btn-outline-danger">ลบข้อมูล</button></form></footer>}</article>}
    </div>
</section>
<div class="drug-catalog-grid">
<main class="drug-list-panel"><div class="panel-head drug-list-head"><div><span>DRUG MASTER</span><h2>รายการยา</h2><small>แสดง @Model.Drugs.Count จากทั้งหมด @Model.TotalCount รายการ · หน้าละ @Model.PageSize รายการ</small></div><button type="button" class="btn btn-outline-secondary audit-preview-button" data-bs-toggle="modal" data-bs-target="#drugAuditModal"><span>↺</span> ประวัติการเปลี่ยนแปลง</button></div><form method="get" class="drug-list-filter"><label><span>ค้นหารายการยา</span><input name="q" value="@Model.SearchTerm" placeholder="ชื่อยา ชื่อการค้า TMT หรือเลขทะเบียน"/></label><label><span>กรองตามโรค</span><input name="icd" value="@Model.Icd10Code" placeholder="รหัส ICD-10"/></label><button class="btn btn-primary">ค้นหา</button><a asp-action="Index" class="btn btn-light">ล้างตัวกรอง</a></form><div class="drug-card-grid">
@if(Model.Drugs.Count==0){<div class="drug-empty">ยังไม่พบรายการยา เริ่มเพิ่มยาแล้วเชื่อมกับ ICD-10</div>}
@foreach(var drug in Model.Drugs)
{
drugDisplayIndex++;
<article class="drug-master-row drug-detail-card @(!drug.IsActive?"inactive":"")">
    <div class="drug-card-content">
        <div class="drug-card-heading">
            <div class="drug-sequence"><span>#</span><strong>@drugDisplayIndex</strong></div>
            <div class="drug-icon">Rx</div>
            <div class="drug-card-identity"><div class="drug-title"><strong>@drug.GenericName</strong>@if(!string.IsNullOrWhiteSpace(drug.Strength)){<b>@drug.Strength</b>}@if(!string.IsNullOrWhiteSpace(drug.DosageForm)){<b>@drug.DosageForm</b>}<span class="status @drug.ApprovalStatus.ToLowerInvariant()">@drug.ApprovalStatus</span></div><p>ข้อมูลยาประจำคลินิก · อัปเดต @drug.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div>
        </div>
        <div class="drug-information-grid">
            <div><span>ชื่อการค้า</span><strong>@(string.IsNullOrWhiteSpace(drug.TradeName)?"ไม่ระบุ":drug.TradeName)</strong></div>
            <div class="manufacturer"><span>บริษัทผู้ผลิต</span><strong>@(string.IsNullOrWhiteSpace(drug.ManufacturerName)?"ไม่ระบุ":drug.ManufacturerName)</strong></div>
            <div><span>ความแรง</span><strong>@(string.IsNullOrWhiteSpace(drug.Strength)?"ไม่ระบุ":drug.Strength)</strong></div>
            <div><span>รูปแบบ / หน่วย</span><strong>@(string.IsNullOrWhiteSpace(drug.DosageForm)?"ไม่ระบุ":drug.DosageForm) / @(string.IsNullOrWhiteSpace(drug.Unit)?"-":drug.Unit)</strong></div>
            <div><span>รหัส TMT</span><strong>@(string.IsNullOrWhiteSpace(drug.TmtCode)?"ไม่ระบุ":drug.TmtCode)</strong></div>
            <div><span>เลขทะเบียนยา</span><strong>@(string.IsNullOrWhiteSpace(drug.RegistrationNumber)?"ไม่ระบุ":drug.RegistrationNumber)</strong></div>
            <div><span>แหล่งข้อมูล</span><strong>@drug.Source</strong></div>
        </div>
        <div class="drug-usage-summary"><span>วิธีใช้ประจำตัวยา</span><strong>@(string.IsNullOrWhiteSpace(drug.UsageText)?"ยังไม่ได้ระบุวิธีใช้":drug.UsageText)</strong></div><div class="drug-protocol-section"><div class="protocol-title"><span>ICD-10 และชื่อโรคภาษาไทย</span><small>@drug.Protocols.Count ความสัมพันธ์</small></div><div class="drug-protocol-chips">@foreach(var link in drug.Protocols.OrderBy(x=>x.DisplayOrder)){<span class="drug-protocol-chip"><span class="protocol-disease"><b>@link.Icd10Code</b><strong>@(Model.Icd10ThaiNames.TryGetValue(link.Icd10Code,out var diseaseName)?diseaseName:"ไม่พบชื่อโรคภาษาไทย")</strong></span><form asp-action="DeleteProtocol" method="post"><input type="hidden" name="id" value="@link.Id"/><button title="ลบการเชื่อมโยง">×</button></form></span>}@if(drug.Protocols.Count==0){<em>ยังไม่ได้เชื่อมโยง ICD-10</em>}</div></div>
    </div>
    <div class="drug-row-actions">@if(canManage){<button type="button" class="btn btn-sm btn-outline-primary" data-edit-drug-details data-id="@drug.Id" data-bs-toggle="modal" data-bs-target="#drugDetailsModal">แก้ไข</button><button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#protocolModal" data-drug-id="@drug.Id" data-drug-name="@drug.GenericName @drug.Strength">ยาเลือกโรค</button><form asp-action="ToggleDrug" method="post"><input type="hidden" name="id" value="@drug.Id"/><button class="btn btn-sm btn-outline-secondary">@(drug.IsActive?"ปิดใช้งาน":"เปิดใช้งาน")</button></form><form asp-action="DeleteDrug" method="post" onsubmit="return confirm('ยืนยันลบรายการยาและความสัมพันธ์ ICD-10 ทั้งหมด?');"><input type="hidden" name="id" value="@drug.Id"/><button class="btn btn-sm btn-outline-danger">ลบ</button></form>}</div>
</article>
}
</div>
@if(Model.TotalPages > 1){<nav class="catalog-pagination" aria-label="หน้ารายการยา"><div><strong>@(((Model.Page-1)*Model.PageSize)+1)–@Math.Min(Model.Page*Model.PageSize,Model.TotalCount)</strong><span>จาก @Model.TotalCount รายการ</span></div><ul>@if(Model.Page>1){<li><a asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-icd="@Model.Icd10Code" asp-route-page="@(Model.Page-1)" aria-label="หน้าก่อน">‹</a></li>}@for(var pageNumber=Math.Max(1,Model.Page-2);pageNumber<=Math.Min(Model.TotalPages,Model.Page+2);pageNumber++){<li><a class="@(pageNumber==Model.Page?"active":"")" asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-icd="@Model.Icd10Code" asp-route-page="@pageNumber">@pageNumber</a></li>}@if(Model.Page<Model.TotalPages){<li><a asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-icd="@Model.Icd10Code" asp-route-page="@(Model.Page+1)" aria-label="หน้าถัดไป">›</a></li>}</ul></nav>}
</main>
</div>
</div>

<div class="modal fade audit-preview-modal" id="drugAuditModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><small>DRUG AUDIT PREVIEW</small><h2 class="modal-title">ประวัติการเปลี่ยนแปลงคลังยา</h2><p>รายการยาและความสัมพันธ์ ICD-10 ล่าสุด @Model.RecentAudit.Count รายการ</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="audit-preview-toolbar"><span>↺ ข้อมูลล่าสุดของคลังยา</span><input type="search" class="form-control" data-audit-search="drugAuditRows" placeholder="ค้นหาการกระทำ รายละเอียด หรือผู้ดำเนินการ"/></div><div class="report-table-wrap"><table class="catalog-report-table"><thead><tr><th>วันเวลา</th><th>การกระทำ</th><th>ประเภทข้อมูล</th><th>รายละเอียด</th><th>ผู้ดำเนินการ</th></tr></thead><tbody id="drugAuditRows">@foreach(var log in Model.RecentAudit){<tr><td class="nowrap">@log.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="audit-action">@log.Action</span></td><td>@log.EntityType</td><td class="audit-detail">@log.Detail</td><td>@(string.IsNullOrWhiteSpace(log.UserName)?"ระบบ":log.UserName)</td></tr>}@if(Model.RecentAudit.Count==0){<tr><td colspan="5" class="report-empty">ยังไม่มีประวัติการเปลี่ยนแปลงคลังยา</td></tr>}</tbody></table></div></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">ปิดหน้าต่าง</button></div></div></div></div>

@if(canManage){
<div class="modal fade" id="icdDrugSelectionModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content drug-modal icd-drug-modal"><div class="modal-header"><div><small>ICD-10 DRUG ASSIGNMENT</small><h2 class="modal-title">จัดรายการยาให้โรค</h2><p>เลือกโรคหนึ่งรายการ แล้วเลือกยาได้มากกว่าหนึ่งชนิดจากคลังยา</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><section class="icd-drug-step"><span>1</span><div><label>ค้นหาโรค ICD‑10</label><input name="Icd10Code" id="icdDrugCode" class="form-control" placeholder="ค้นหารหัสหรือชื่อโรค"/></div><button type="button" class="btn btn-primary" id="loadIcdDrugs">แสดงรายการยา</button></section><div id="icdDrugState" class="icd-drug-state">เลือกรหัส ICD‑10 เพื่อเริ่มจัดยาให้โรค</div><section id="icdDrugPicker" hidden><div class="icd-drug-picker-toolbar"><div><strong id="icdDrugDiseaseName">-</strong><small id="icdDrugSelectedCount">เลือก 0 รายการ</small></div><input type="search" id="icdDrugSearch" class="form-control" placeholder="ค้นหาชื่อยา ชื่อการค้า บริษัท หรือความแรง"/><button type="button" class="btn btn-light" id="selectAllIcdDrugs">เลือกทั้งหมด</button><button type="button" class="btn btn-light" id="clearAllIcdDrugs">ล้างที่เลือก</button></div><div id="icdDrugCards" class="icd-drug-cards"></div></section></div><div class="modal-footer"><span class="icd-drug-footer-note">ยาหนึ่งตัวเชื่อมได้หลายโรค และหนึ่งโรคเลือกยาได้หลายชนิด</span><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button type="button" class="btn btn-primary" id="saveIcdDrugs" disabled>บันทึกรายการยาของโรค</button></div></div></div></div>
<div class="modal fade" id="icdDrugSaveReportModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content icd-save-report-modal"><div class="modal-header"><span class="icd-save-check">✓</span><div><small>ICD‑10 SAVE REPORT</small><h2 class="modal-title">บันทึกรายการยาของโรคเรียบร้อย</h2><p>สรุปข้อมูลที่บันทึกเข้าสู่รายงานยาตามโรค</p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="icd-save-disease"><span id="icdSaveReportCode">-</span><div><strong id="icdSaveReportThai">-</strong><small id="icdSaveReportEnglish">-</small></div></div><div class="icd-save-stats"><div><span>ยาที่เลือก</span><strong id="icdSaveReportSelected">0</strong></div><div><span>เพิ่มใหม่</span><strong id="icdSaveReportAdded">0</strong></div><div><span>นำออก</span><strong id="icdSaveReportRemoved">0</strong></div></div><section><header><strong>รายการยาที่บันทึก</strong><small>ข้อมูลจะแสดงในรายงานบนหน้าเพจทันทีหลังปิดหน้าต่าง</small></header><div id="icdSaveReportDrugs" class="icd-save-drug-list"></div></section></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">ดูรายงานบนหน้าเพจ</button></div></div></div></div>
<div class="modal fade" id="drugDetailsModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content drug-modal saved-drug-edit-modal"><form asp-action="SaveDrugDetails" method="post" id="drugDetailsForm"><div class="modal-header"><div class="saved-edit-heading"><span class="saved-edit-rx">Rx</span><div><small>DRUG MASTER · FULL EDIT</small><h2 class="modal-title">แก้ไขรายการยาและวิธีใช้</h2><p>ข้อมูลวิธีใช้ผูกกับตัวยา ส่วน ICD‑10 ใช้เชื่อมโยงยากับโรค</p></div></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="drugDetailsLoading" class="saved-edit-loading">กำลังโหลดข้อมูลรายการยา...</div><div id="drugDetailsContent" hidden><input type="hidden" name="Id"/><input type="hidden" name="Source"/><section class="saved-edit-section"><header><span>01</span><div><strong>ข้อมูลรายการยา</strong><small>ชื่อยา บริษัทผู้ผลิต ความแรง และข้อมูลทะเบียน</small></div><b id="drugDetailsStatus">Approved</b></header><div class="saved-edit-grid"><label class="wide">ชื่อยา/ชื่อสามัญ *<input name="GenericName" class="form-control" required/></label><label>ชื่อการค้า<input name="TradeName" class="form-control"/></label><label>ความแรง<input name="Strength" class="form-control" placeholder="เช่น 500 mg"/></label><label class="wide">ชื่อบริษัทยา/ผู้ผลิต<input name="ManufacturerName" class="form-control" list="drugManufacturerOptions" autocomplete="off"/></label><label>รูปแบบยา<input name="DosageForm" class="form-control"/></label><label>หน่วย<input name="Unit" class="form-control"/></label><label>รหัส TMT<input name="TmtCode" class="form-control"/></label><label>เลขทะเบียนยา<input name="RegistrationNumber" class="form-control"/></label></div></section><section class="saved-edit-section drug-usage-section"><header><span>02</span><div><strong>ขนาดและคำแนะนำการใช้ยา</strong><small>ข้อมูลชุดนี้เป็นของตัวยาและใช้ร่วมกันทุกโรคที่เชื่อมโยง</small></div><b>ผูกกับยา</b></header><div class="saved-edit-grid drug-usage-grid"><label>ครั้งละ<input name="DoseAmount" class="form-control"/></label><label>วันละ (ครั้ง)<input name="FrequencyPerDay" class="form-control"/></label><label>เวลาอาหาร<select name="MealTiming" class="form-select"><option value="">ไม่ระบุ</option><option value="ก่อนอาหาร">ก่อนอาหาร</option><option value="หลังอาหาร">หลังอาหาร</option></select></label><label>ทุกกี่ชั่วโมง<input name="IntervalHours" class="form-control"/></label><div class="saved-time-options drug-time-options"><span>ช่วงเวลาที่ใช้ยา</span><label><input type="checkbox" name="Morning" value="true"/> เช้า</label><label><input type="checkbox" name="Noon" value="true"/> เที่ยง</label><label><input type="checkbox" name="Evening" value="true"/> เย็น</label><label><input type="checkbox" name="Bedtime" value="true"/> ก่อนนอน</label></div><label class="wide">วิธีใช้<textarea name="UsageText" class="form-control" rows="3"></textarea></label><label class="wide">คำแนะนำเฉพาะยา<textarea name="AdviceText" class="form-control" rows="3"></textarea></label></div></section><section class="saved-edit-section protocol-editor-section"><header><span>03</span><div><strong>โรคที่เชื่อมโยงกับยา</strong><small>ICD‑10 ระบุว่ายานี้ใช้แนะนำกับโรคใด ไม่เก็บขนาดหรือวิธีใช้ซ้ำ</small></div><b id="drugDetailsProtocolCount">0 รายการ</b></header><div id="drugDetailsProtocols" class="saved-protocol-list"></div></section></div></div><div class="modal-footer"><span class="saved-edit-note">✓ บันทึกข้อมูลยา 1 ชุด และความสัมพันธ์ ICD‑10 แยกจากกัน</span><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button class="btn btn-primary" id="saveDrugDetailsButton">บันทึกการแก้ไข</button></div></form></div></div></div>
<div class="modal fade" id="drugModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content drug-modal saved-drug-edit-modal"><form asp-action="SaveDrug" method="post" id="drugForm"><div class="modal-header"><div class="saved-edit-heading"><span class="saved-edit-rx">Rx</span><div><small>DRUG MASTER</small><h2 class="modal-title" id="drugModalTitle">เพิ่มยาเข้าคลังคลินิก</h2><p>สร้างข้อมูลยาและวิธีใช้ก่อน แล้วค่อยจัดยาให้โรค ICD‑10</p></div></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="Id"/><input type="hidden" name="Source" value="Clinic"/><section class="saved-edit-section"><header><span>01</span><div><strong>ข้อมูลรายการยา</strong><small>ชื่อยา บริษัทผู้ผลิต ความแรง และข้อมูลทะเบียน</small></div><b>ยาใหม่</b></header><div class="saved-edit-grid"><label class="wide">ชื่อยา/ชื่อสามัญ *<input name="GenericName" class="form-control" required/></label><label>ชื่อการค้า<input name="TradeName" class="form-control"/></label><label>ความแรง<input name="Strength" class="form-control" placeholder="เช่น 500 mg"/></label><label class="wide">ชื่อบริษัทยา/ผู้ผลิต<input name="ManufacturerName" class="form-control" list="drugManufacturerOptions" autocomplete="off" placeholder="พิมพ์เพื่อค้นหาหรือเลือกชื่อเดิม"/></label><label>รูปแบบยา<input name="DosageForm" class="form-control" placeholder="tablet"/></label><label>หน่วย<input name="Unit" class="form-control" placeholder="เม็ด"/></label><label>รหัส TMT<input name="TmtCode" class="form-control"/></label><label>เลขทะเบียนยา<input name="RegistrationNumber" class="form-control"/></label></div></section><section class="saved-edit-section"><header><span>02</span><div><strong>ขนาดและคำแนะนำการใช้ยา</strong><small>ข้อมูลนี้ผูกกับยา ไม่ผูกกับ ICD‑10</small></div><b>ผูกกับยา</b></header><div class="saved-edit-grid drug-usage-grid"><label>ครั้งละ<input name="DoseAmount" class="form-control"/></label><label>วันละ (ครั้ง)<input name="FrequencyPerDay" class="form-control"/></label><label>เวลาอาหาร<select name="MealTiming" class="form-select"><option value="">ไม่ระบุ</option><option value="ก่อนอาหาร">ก่อนอาหาร</option><option value="หลังอาหาร">หลังอาหาร</option></select></label><label>ทุกกี่ชั่วโมง<input name="IntervalHours" class="form-control"/></label><div class="saved-time-options drug-time-options"><span>ช่วงเวลาที่ใช้ยา</span><label><input type="checkbox" name="Morning" value="true"/> เช้า</label><label><input type="checkbox" name="Noon" value="true"/> เที่ยง</label><label><input type="checkbox" name="Evening" value="true"/> เย็น</label><label><input type="checkbox" name="Bedtime" value="true"/> ก่อนนอน</label></div><label class="wide">วิธีใช้<textarea name="UsageText" class="form-control" rows="3"></textarea></label><label class="wide">คำแนะนำเฉพาะยา<textarea name="AdviceText" class="form-control" rows="3"></textarea></label></div></section><div class="duplicate-note">ระบบตรวจรายการซ้ำจากชื่อสามัญ + ความแรง + รูปแบบยา + บริษัทผู้ผลิต ก่อนบันทึก</div></div><div class="modal-footer"><span class="saved-edit-note">ขั้นต่อไปใช้ปุ่ม “จัดยาตามโรค” เพื่อเลือกยาให้ ICD‑10</span><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button class="btn btn-primary" id="drugSaveButton">บันทึกยา</button></div></form></div></div></div><datalist id="drugManufacturerOptions">@foreach(var manufacturer in Model.ManufacturerNames){<option value="@manufacturer"></option>}</datalist>
<div class="modal fade" id="protocolModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content drug-modal"><form asp-action="SaveProtocol" method="post"><div class="modal-header"><div><small>ICD-10 RELATION</small><h2 class="modal-title">ผูกยาเข้ากับโรค</h2><p id="protocolDrugName"></p></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="ClinicDrugId" id="protocolDrugId"/><div class="alert alert-info">ขนาดและวิธีใช้เก็บอยู่ที่ข้อมูลยา หน้านี้ใช้เพิ่มความสัมพันธ์กับโรคเท่านั้น</div><div class="row g-3"><div class="col-md-4"><label>รหัส ICD-10 *</label><input name="Icd10Code" class="form-control" required/></div><div class="col-md-4"><label>ประเภท</label><select name="DiagnosisType" class="form-select"><option value="Primary">วินิจฉัยหลัก</option><option value="Differential">วินิจฉัยแยกโรค</option><option value="Symptom">อาการเบื้องต้น</option></select></div><div class="col-md-4"><label>ลำดับแนะนำ</label><input name="DisplayOrder" type="number" class="form-control" value="0"/></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button><button class="btn btn-primary">บันทึกความสัมพันธ์</button></div></form></div></div></div>
