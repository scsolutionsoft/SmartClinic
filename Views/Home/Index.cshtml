@{
    ViewData["Title"] = "แดชบอร์ด";
}

<section class="hero-panel p-4 p-lg-5 mb-4 rounded-4 text-white">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge bg-light text-dark mb-3">SmartClinic</span>
            <h1 class="display-5 fw-semibold mb-3">แพลตฟอร์มบริหารจัดการคลินิก</h1>
            <p class="lead mb-0">ระบบบริหารคลินิก ประวัติการรักษา ลายเซ็นผู้รับบริการ และรายงาน พร้อมธีม Bootswatch ที่สวยงามและหรูหรา</p>
        </div>
        <div class="col-lg-4">
            <div class="glass-card p-3 p-lg-4 rounded-4">
                <div class="fw-semibold mb-2">ตัวอย่างธีม</div>
                <div class="small opacity-75">เลือกธีมจากแถบด้านบนได้ทันที</div>
                <div class="small opacity-75">รองรับการปรับลุคให้เข้ากับภาพลักษณ์คลินิก</div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">ข้อมูลคลินิก</h5>
                <p class="card-text">ใช้ข้อมูลจาก สปสช. เป็นข้อมูลหลักทั้งรหัส ชื่อ และที่อยู่</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">ผู้ป่วยและ OPD</h5>
                <p class="card-text">รองรับข้อมูลผู้ป่วย ไฟล์ OPD Card PDF และภาพลายเซ็นผู้รับบริการ</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">รายงาน</h5>
                <p class="card-text">พิมพ์รายงานประวัติการรักษาและแสดงลายเซ็นใต้ไฟล์ PDF ได้</p>
            </div>
        </div>
    </div>
</div>


