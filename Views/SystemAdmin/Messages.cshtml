@model IReadOnlyList<AdminMessage>
@{ViewData["Title"]="ข้อความติดต่อแอดมิน";var selectedStatus=(string)ViewBag.Status;}
<div class="sa-page"><header class="sa-page-head"><div><span>ADMIN INBOX</span><h1>ข้อความจากคลินิกสมาชิก</h1><p>ติดตามคำถาม ปัญหาการใช้งาน และการติดต่อกลับอย่างเป็นระบบ</p></div></header><form method="get" class="sa-filter compact"><select name="status" class="form-select"><option value="">ทุกสถานะ</option>@foreach(var s in new[]{"New","InProgress","Replied","Closed"}){<option value="@s" selected="@(selectedStatus==s)">@s</option>}</select><button class="btn btn-dark">กรอง</button></form><div class="message-admin-list">@foreach(var m in Model){<article class="sa-panel"><header><div><span class="sa-status @m.Status.ToLowerInvariant()">@m.Status</span><h2>@m.Subject</h2><small>@m.ClinicCode · @m.ContactName · <a href="tel:@m.PhoneNumber">@m.PhoneNumber</a> · @m.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div></header><p>@m.Message</p><form asp-action="ReplyMessage" method="post"><input type="hidden" name="id" value="@m.Id"/><textarea name="adminReply" class="form-control" rows="3" placeholder="ข้อความตอบกลับหรือบันทึกการดำเนินการ">@m.AdminReply</textarea><div><select name="status" class="form-select"><option value="InProgress">กำลังดำเนินการ</option><option value="Replied">ตอบกลับแล้ว</option><option value="Closed">ปิดเรื่อง</option></select><button class="btn btn-primary">บันทึกการตอบกลับ</button></div></form></article>}</div></div>
