@model SystemClinicsViewModel
@{ViewData["Title"]="คลินิกสมาชิก";}
<div class="sa-page"><header class="sa-page-head"><div><span>MEMBER MANAGEMENT</span><h1>คลินิกสมาชิก</h1><p>ข้อมูลจากหน้าสมัครสมาชิกจะแสดงในรายการนี้อัตโนมัติ</p></div><a asp-controller="Clinics" asp-action="Register" class="btn btn-primary">+ เพิ่มคลินิกด้วยตนเอง</a></header>
<form method="get" class="sa-filter"><input name="search" value="@Model.Search" class="form-control" placeholder="ค้นหาชื่อ รหัส ผู้ดูแล เบอร์โทร หรืออีเมล"/><select name="status" class="form-select"><option value="">ทุกสถานะ</option>@foreach(var s in new[]{"Active","Pending","Suspended","Expired","Rejected","Closed"}){<option value="@s" selected="@(Model.Status==s)">@s</option>}</select><button class="btn btn-dark">ค้นหา</button></form>
<section class="sa-panel"><div class="sa-panel-head"><div><span>CLINIC DIRECTORY</span><h2>@Model.Clinics.Count คลินิก</h2></div></div><div class="table-responsive"><table class="table sa-table"><thead><tr><th>คลินิก</th><th>ผู้ดูแล</th><th>ติดต่อ</th><th>รายการ OPD</th><th>เครดิต OPD คงเหลือ</th><th>แผน</th><th>สถานะ</th><th></th></tr></thead><tbody>@foreach(var c in Model.Clinics){<tr><td><strong>@c.ClinicName</strong><small>@c.ClinicCode · สมัคร @c.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small></td><td>@c.ContactName</td><td>@c.PhoneNumber<small>@c.Email</small></td><td>@c.UsedPatients</td><td><strong>@(c.IsUnlimited?"∞":c.Remaining)</strong></td><td>@(c.IsUnlimited?"Unlimited":$"{c.PatientLimit} เครดิต OPD")</td><td><span class="sa-status @c.Status.ToLowerInvariant()">@c.Status</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Clinic" asp-route-id="@c.Id">เปิดข้อมูล</a></td></tr>}</tbody></table></div></section></div>
