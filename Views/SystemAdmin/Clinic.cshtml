@model SystemClinicItemViewModel
@{ViewData["Title"]=Model.ClinicName;var clinicUsers=(IReadOnlyList<ApplicationUser>)ViewBag.Users;var slips=(IReadOnlyList<PaymentSlip>)ViewBag.Slips;var messages=(IReadOnlyList<AdminMessage>)ViewBag.Messages;var audit=(IReadOnlyList<AdminAuditLog>)ViewBag.Audit;}
<div class="sa-page"><div class="sa-breadcrumb"><a asp-action="Clinics">คลินิกสมาชิก</a><span>/</span>@Model.ClinicName</div><header class="clinic-admin-head"><div class="clinic-admin-mark">@Model.ClinicName.Substring(0,1)</div><div><span>@Model.ClinicCode</span><h1>@Model.ClinicName</h1><p>@Model.ContactName · @Model.PhoneNumber · @Model.Email</p></div><span class="sa-status @Model.Status.ToLowerInvariant()">@Model.Status</span></header>
<section class="clinic-admin-stats"><div><small>รายการ OPD ที่ใช้เครดิต</small><strong>@Model.UsedPatients</strong></div><div><small>เครดิต OPD รวม</small><strong>@(Model.IsUnlimited?"∞":Model.PatientLimit)</strong></div><div><small>คงเหลือ</small><strong>@(Model.IsUnlimited?"Unlimited":Model.Remaining)</strong></div><div><small>ผู้ใช้งาน</small><strong>@clinicUsers.Count</strong></div></section>
<div class="sa-grid"><section class="sa-panel"><div class="sa-panel-head"><h2>สถานะคลินิก</h2></div><form asp-action="UpdateClinicStatus" method="post" class="sa-action-form"><input type="hidden" name="id" value="@Model.Id"/><select name="status" class="form-select">@foreach(var s in new[]{"Active","Pending","Suspended","Expired","Rejected","Closed"}){<option value="@s" selected="@(Model.Status==s)">@s</option>}</select><textarea name="note" class="form-control" placeholder="เหตุผลหรือหมายเหตุ"></textarea><button class="btn btn-primary">อัปเดตสถานะ</button></form></section><section class="sa-panel"><div class="sa-panel-head"><h2>ผู้ใช้งานคลินิก</h2></div><div class="sa-feed">@foreach(var u in clinicUsers){<div><i class="user">@((u.FullName??u.UserName??"U").Substring(0,1))</i><div><strong>@(u.FullName??u.UserName)</strong><small>@u.UserName · @(u.LockoutEnd>DateTimeOffset.UtcNow?"ล็อก":"ใช้งาน")</small></div></div>}</div></section>
<section class="sa-panel"><div class="sa-panel-head"><h2>สลิปโอนเงิน</h2><a asp-action="Slips" asp-route-search="@Model.ClinicCode">ดูทั้งหมด</a></div><div class="sa-feed">@foreach(var s in slips){<a asp-action="SlipFile" asp-route-id="@s.Id" target="_blank"><i class="slip">฿</i><div><strong>@s.Amount.ToString("N2") บาท</strong><small>@s.Status · @s.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small></div></a>}</div></section><section class="sa-panel"><div class="sa-panel-head"><h2>ข้อความติดต่อ</h2></div><div class="sa-feed">@foreach(var m in messages){<div><i class="message">✉</i><div><strong>@m.Subject</strong><small>@m.Status · @m.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small></div></div>}</div></section>
<section class="sa-panel span2"><div class="sa-panel-head"><h2>Audit Log</h2></div><div class="sa-audit">@foreach(var a in audit){<article><time>@a.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time><strong>@a.Action</strong><p>@a.Detail</p></article>}</div></section></div></div>
