@model SlipReportViewModel
@{ViewData["Title"]="รายงานสลิปโอนเงิน";}
<div class="sa-page"><header class="sa-page-head"><div><span>PAYMENT & CREDIT</span><h1>รายงานสลิปโอนเงิน</h1><p>ตรวจหลักฐานการโอน อนุมัติเครดิต และติดตามรายการย้อนหลัง</p></div><div class="sa-total"><small>ยอดตามรายการที่แสดง</small><strong>@Model.TotalAmount.ToString("N2") บาท</strong></div></header>
<form method="get" class="sa-filter"><input name="search" value="@Model.Search" class="form-control" placeholder="ค้นหารหัสคลินิก ผู้ติดต่อ หรือเลขอ้างอิง"/><select name="status" class="form-select"><option value="">ทุกสถานะ</option>@foreach(var s in new[]{"Pending","Approved","Rejected"}){<option value="@s" selected="@(Model.Status==s)">@s</option>}</select><button class="btn btn-dark">ค้นหา</button></form>
@if((TempData["AdminError"] as string) is string error){<div class="alert alert-warning">@error</div>}
<section class="sa-panel"><div class="table-responsive"><table class="table sa-table"><thead><tr><th>วันที่แจ้ง</th><th>คลินิก</th><th>รายการ OPD/เครดิต</th><th>ยอดโอน</th><th>คำขอ</th><th>สลิป</th><th>สถานะ</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){var s=item.Slip;<tr><td>@s.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<small>โอน @s.TransferDateTime.ToString("dd/MM/yyyy HH:mm")</small></td><td><strong>@item.ClinicName</strong><small>@s.ClinicCode · @s.ContactName · @s.PhoneNumber</small></td><td>@item.UsedPatients รายการ OPD<small>คงเหลือ @(item.IsUnlimited?"∞":item.Remaining)</small></td><td><strong>@s.Amount.ToString("N2")</strong><small>@s.TransferBank · @s.TransferReference</small></td><td>@(s.RequestUnlimited?"Unlimited":$"{s.RequestedCredits} เครดิต OPD")</td><td><button type="button" class="btn btn-sm btn-outline-primary" data-slip-url="@Url.Action("SlipFile",new{id=s.Id})" data-slip-title="สลิป #@s.Id · @s.ClinicCode">ดูสลิป</button></td><td><span class="sa-status @s.Status.ToLowerInvariant()">@s.Status</span></td><td>@if(s.Status=="Pending"){<button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#processSlipModal" data-id="@s.Id" data-clinic="@item.ClinicName" data-credits="@s.RequestedCredits" data-unlimited="@s.RequestUnlimited.ToString().ToLowerInvariant()" data-slip-url="@Url.Action("SlipFile",new{id=s.Id})">ตรวจสอบ</button>}else{<small>@s.AdminNote</small>}</td></tr>}</tbody></table></div></section></div>
<div class="modal fade" id="slipPreviewModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content sa-slip-modal"><div class="modal-header"><h2 class="modal-title" id="slipPreviewTitle">สลิปโอนเงิน</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><iframe id="slipPreviewFrame" title="หลักฐานการโอนเงิน"></iframe></div></div></div></div>
<div class="modal fade" id="processSlipModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content sa-slip-modal"><form asp-action="ProcessSlip" method="post"><div class="modal-header"><div><span>VERIFY PAYMENT</span><h2 class="modal-title">ตรวจสอบและเติมเครดิต</h2></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body process-slip-grid"><iframe id="processSlipFrame" title="สลิปสำหรับตรวจสอบ"></iframe><div><input type="hidden" name="id" id="processSlipId"/><div class="process-clinic" id="processClinic"></div><label class="form-label">จำนวนเครดิตที่เพิ่ม</label><input name="credits" id="processCredits" type="number" min="0" class="form-control"/><div class="form-check form-switch unlimited-switch"><input name="unlimited" value="true" type="checkbox" class="form-check-input" id="processUnlimited"/><label class="form-check-label" for="processUnlimited">อนุมัติเป็น Unlimited</label></div><label class="form-label">หมายเหตุ</label><textarea name="adminNote" class="form-control" rows="4"></textarea><div class="d-grid gap-2 mt-3"><button name="decision" value="Approve" class="btn btn-success">ยืนยันสลิปและเติมเครดิต</button><button name="decision" value="Reject" class="btn btn-outline-danger">ปฏิเสธสลิป</button></div></div></div></form></div></div></div>
<script>document.querySelectorAll('[data-slip-url]').forEach(b=>{if(b.dataset.bsTarget)return;b.addEventListener('click',()=>{document.getElementById('slipPreviewFrame').src=b.dataset.slipUrl;document.getElementById('slipPreviewTitle').textContent=b.dataset.slipTitle;bootstrap.Modal.getOrCreateInstance(document.getElementById('slipPreviewModal')).show()})});document.getElementById('processSlipModal')?.addEventListener('show.bs.modal',e=>{const b=e.relatedTarget;document.getElementById('processSlipId').value=b.dataset.id;document.getElementById('processClinic').textContent=b.dataset.clinic;document.getElementById('processCredits').value=b.dataset.credits;document.getElementById('processUnlimited').checked=b.dataset.unlimited==='true';document.getElementById('processSlipFrame').src=b.dataset.slipUrl});</script>
