@model SystemAdminDashboardViewModel
@{ViewData["Title"]="ศูนย์บริหารระบบ";}
<div class="sa-page"><header class="sa-hero"><div><span>SYSTEM ADMINISTRATION</span><h1>ศูนย์บริหาร SmartClinic</h1><p>ภาพรวมคลินิกสมาชิก เครดิต การชำระเงิน และการติดต่อทั้งหมด</p></div><div class="sa-live"><i></i>ข้อมูลล่าสุด @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div></header>
<section class="sa-kpis"><a asp-action="Clinics"><span>คลินิกสมาชิก</span><strong>@Model.TotalClinics</strong><small>เปิดใช้งาน @Model.ActiveClinics · Unlimited @Model.UnlimitedClinics</small></a><a asp-action="Clinics"><span>ผู้ป่วยในระบบ</span><strong>@Model.TotalPatients.ToString("N0")</strong><small>จากทุกคลินิกสมาชิก</small></a><a asp-action="Slips" asp-route-status="Pending" class="attention"><span>สลิปรอตรวจ</span><strong>@Model.PendingSlips</strong><small>ยอดรวม @Model.PendingAmount.ToString("N2") บาท</small></a><a asp-action="Messages" asp-route-status="New"><span>ข้อความใหม่</span><strong>@Model.NewMessages</strong><small>รอการตอบกลับจากแอดมิน</small></a></section>
<div class="sa-grid"><section class="sa-panel span2"><div class="sa-panel-head"><div><span>MEMBERS</span><h2>คลินิกสมาชิกล่าสุด</h2></div><a asp-action="Clinics">ดูทั้งหมด →</a></div><div class="table-responsive"><table class="table sa-table"><thead><tr><th>คลินิก</th><th>ผู้ติดต่อ</th><th>รายการ OPD</th><th>เครดิต OPD</th><th>สถานะ</th><th></th></tr></thead><tbody>@foreach(var c in Model.Clinics){<tr><td><strong>@c.ClinicName</strong><small>@c.ClinicCode</small></td><td>@c.ContactName<small>@c.PhoneNumber</small></td><td>@c.UsedPatients</td><td>@(c.IsUnlimited?"∞ Unlimited":$"{c.Remaining}/{c.PatientLimit}")</td><td><span class="sa-status @c.Status.ToLowerInvariant()">@c.Status</span></td><td><a asp-action="Clinic" asp-route-id="@c.Id">จัดการ</a></td></tr>}</tbody></table></div></section>
<section class="sa-panel"><div class="sa-panel-head"><div><span>PAYMENTS</span><h2>สลิปล่าสุด</h2></div><a asp-action="Slips">รายงาน →</a></div><div class="sa-feed">@foreach(var s in Model.RecentSlips){<a asp-action="Slips" asp-route-search="@s.ClinicCode"><i class="slip">฿</i><div><strong>@s.ClinicCode · @s.Amount.ToString("N2") บาท</strong><small>@s.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm") · @s.Status</small></div></a>}</div></section>
<section class="sa-panel"><div class="sa-panel-head"><div><span>CONTACT</span><h2>ข้อความล่าสุด</h2></div><a asp-action="Messages">กล่องข้อความ →</a></div><div class="sa-feed">@foreach(var m in Model.RecentMessages){<a asp-action="Messages"><i class="message">✉</i><div><strong>@m.Subject</strong><small>@m.ClinicCode · @m.ContactName · @m.Status</small></div></a>}</div></section>
<section class="sa-panel span2"><div class="sa-panel-head"><div><span>AUDIT TRAIL</span><h2>กิจกรรมผู้ดูแลระบบ</h2></div></div><div class="sa-audit">@foreach(var a in Model.RecentActivity){<article><time>@a.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time><strong>@a.Action</strong><span>@a.ClinicCode</span><p>@a.Detail</p></article>}</div></section></div></div>
